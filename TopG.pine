//@version=6
indicator("TopG v0.5.1-dev - Combined Real Events", overlay=true, max_lines_count=450, max_labels_count=450, max_boxes_count=250, calc_bars_count=1200)
// Native engine plus selected-source transport audit. UNVERIFIED until chart tests pass.
// D-006 preserved. Opt-in combined audit; no taps, usage or entries.
// COVERAGE: chart execution window controlled by Calculated bars (verify externally, limit capacity); source request count sourceBars + 2; missing starts are never replaced.
start = input.time(timestamp("01 Oct 2026 00:00 +0530"), "Starting candle OPEN time", confirm=true, group="Initialization")
initialDir = input.string("Upward", "Starting direction", options=["Upward", "Downward"], group="Initialization")
msmView = input.string("History", "MSM view", options=["Off", "Latest", "History"], group="Display")
chochView = input.string("History", "CHOCH view", options=["Off", "Latest", "History"], group="Display")
issView = input.string("History", "ISS view", options=["Off", "Latest", "History"], group="Display")
keepPoints = input.int(100, "MSM confirmed points retained", minval=2, maxval=100, group="Display")
keepChoch = input.int(15, "CHOCH events retained", minval=1, maxval=20, group="Display")
keepISS = input.int(15, "ISS events retained", minval=1, maxval=30, group="Display")
showEvents = input.bool(true, "Show discovery / confirmation candle markers", group="Display")
showInternal = input.bool(false, "Show current ISS internal points (diagnostic)", group="Display")
showAudit = input.bool(false, "Show latest CHOCH audit panel", group="Display")
showISSAudit = input.bool(false, "Show ISS audit (takes panel priority)", group="Display")
showCalcAudit = input.bool(false, "Show calculation-event audit", group="Display")
tjlView = input.string("History", "TJL view", options=["Off", "Latest", "History"], group="TJL")
keepTJL = input.int(15, "TJL structural pairs retained", minval=2, maxval=20, group="TJL")
showTJLAudit = input.bool(false, "Show TJL audit (takes audit panel priority)", group="TJL")
limit = input.int(20000, "Candle storage safety limit", minval=100, maxval=30000, group="Safety")
h1Diagnostic = input.string("Off", "H1 diagnostic", options=["Off", "Native H1 audit", "Requested H1 on M1", "Native selected TF audit", "Requested selected TF on M1"], group="H1 transport diagnostic")
auditSource = input.string("60", "Selected source timeframe (1D / 240 / 60 / 5)", options=["1D", "240", "60", "5"], group="H1 transport diagnostic")
// One source at a time. Set Initialization start/direction for that source.
// Legacy H1 modes remain fixed at 60 regardless of the new source selector.
string auditTF = h1Diagnostic == "Native selected TF audit" or h1Diagnostic == "Requested selected TF on M1" ? auditSource : "60"
bool auditRequested = h1Diagnostic == "Requested H1 on M1" or h1Diagnostic == "Requested selected TF on M1"
bool auditNative = h1Diagnostic == "Native H1 audit" or h1Diagnostic == "Native selected TF audit"
// v0.5.1: combined real-event audit. Manual initialization remains independent.
combined = input.bool(false, "Combined real-event audit (M1 only)", group="Combined MTF")
sourceBars = input.int(300, "Requested source calculation bars", minval=50, maxval=3000, group="Combined MTF")
keepWire = input.int(64, "Full real-event records retained", minval=8, maxval=256, group="Combined MTF")
inspectTF = input.string("5", "Detailed combined source", options=["1D", "240", "60", "5", "1"], group="Combined MTF")
inspectRecord = input.int(0, "Record offset from newest retained (all sources)", minval=0, maxval=255, group="Combined MTF")
showPayload = input.bool(false, "Show inspected full event payload", group="Combined MTF")
startD = input.time(timestamp("01 Oct 2026 00:00 +0530"), "D1 source OPEN", group="Combined D1 initialization")
upD = input.bool(true, "D1 starts upward (false = downward)", group="Combined D1 initialization")
start4 = input.time(timestamp("01 Oct 2026 00:00 +0530"), "H4 source OPEN", group="Combined H4 initialization")
up4 = input.bool(true, "H4 starts upward (false = downward)", group="Combined H4 initialization")
start1 = input.time(timestamp("01 Oct 2026 00:00 +0530"), "H1 source OPEN", group="Combined H1 initialization")
up1 = input.bool(true, "H1 starts upward (false = downward)", group="Combined H1 initialization")
start5 = input.time(timestamp("01 Oct 2026 00:00 +0530"), "M5 source OPEN", group="Combined M5 initialization")
up5 = input.bool(true, "M5 starts upward (false = downward)", group="Combined M5 initialization")
startM = input.time(timestamp("01 Oct 2026 00:00 +0530"), "M1 source OPEN", group="Combined M1 initialization")
upM = input.bool(true, "M1 starts upward (false = downward)", group="Combined M1 initialization")
if combined and (not (timeframe.isminutes and timeframe.multiplier == 1) or h1Diagnostic != "Off")
    runtime.error("Combined audit requires M1 and H1 diagnostic Off")
f_ext(array<float> a, int first, int last, bool highest) =>
    float best = na
    int chosen = na
    if first >= 0 and last >= first and last < array.size(a)
        for j = first to last
            float v = array.get(a, j)
            if na(best) or (highest ? v >= best : v <= best)
                best := v
                chosen := j
    [best, chosen]
f_in(float price, float lower, float upper) =>
    price >= lower and price <= upper
type Structure
    bool up = true
    int ref = 0
    int gate = -1
    bool pending = false
    int ti = na
    int identified = na
    int known = na
    float tentative = na
    float ch = na
    float cl = na
    int hi = na
    int li = na
    int pairs = 0
method step(Structure s, int i, array<float> bodyHighs, array<float> bodyLows, float candleOpen, float candleClose, float previousOpen, float previousClose, float previousHigh, float previousLow, int candleCloseTime) =>
    int eventCode = 0
    if s.pending
        if i > s.identified and (s.up ? candleClose > s.tentative : candleClose < s.tentative)
            [opposite, oi] = f_ext(s.up ? bodyLows : bodyHighs, s.ti, i, not s.up)
            s.ch := s.up ? s.tentative : opposite
            s.cl := s.up ? opposite : s.tentative
            s.hi := s.up ? s.ti : oi
            s.li := s.up ? oi : s.ti
            s.pairs += 1
            s.ref := oi
            s.gate := i
            s.pending := false
            s.tentative := na
            s.ti := na
            eventCode := 2
    else if i >= 1 and i - 1 > s.gate
        bool valid = s.up ? previousClose < previousOpen and candleClose < candleOpen and candleClose < previousLow : previousClose > previousOpen and candleClose > candleOpen and candleClose > previousHigh
        if valid
            if i - 2 < s.ref
                eventCode := 3
            else
                [v, vi] = f_ext(s.up ? bodyHighs : bodyLows, s.ref, i - 2, s.up)
                s.tentative := v
                s.ti := vi
                s.identified := i
                s.known := candleCloseTime
                s.pending := true
                eventCode := 1
    eventCode
type ChochState
    int run = 0
    int count = 0
    int confirmedAt = na
    bool bullish = false
method evaluate(ChochState c, Structure s, int i, int structureEvent, float candleClose, int candleCloseTime) =>
    bool confirmed = false
    if structureEvent == 1 or structureEvent == 2
        c.run := 0
    if structureEvent != 2
        bool qualifies = s.pending and not na(s.hi) and not na(s.li) and i >= s.identified and (s.up ? candleClose < s.cl : candleClose > s.ch)
        c.run := qualifies ? c.run + 1 : 0
        if c.run == 2
            c.count += 1
            c.confirmedAt := candleCloseTime
            c.bullish := not s.up
            c.run := 0
            confirmed := true
    confirmed
method restartAfterChoch(Structure s, int confirmationIndex) =>
    s.ref := s.ti
    s.gate := confirmationIndex
    s.up := not s.up
    s.pairs := 0
    s.pending := false
    s.tentative := na
    s.ti := na
    true
type ISSState
    Structure internal = na
    array<float> values = na
    array<int> origins = na
    bool running = false
    bool eligible = false
    float lower = na
    float upper = na
    int born = na
    int candidates = 0
    int count = 0
    int rejected = 0
    int outside = 0
    int cancelled = 0
    int confirmedAt = na
    bool bullish = false
    int internalEvent = 0
    bool fifth = false
    bool allInside = false
    bool closeInside = false
method beginSearch(ISSState s, Structure source, int i) =>
    array.clear(s.values)
    array.clear(s.origins)
    s.internalEvent := 0
    s.fifth := false
    s.allInside := false
    s.closeInside := false
    float level2 = source.up ? source.cl : source.ch
    bool found = not na(level2)
    s.running := found
    s.eligible := found
    if found
        s.candidates += 1
        s.lower := math.min(level2, source.tentative)
        s.upper := math.max(level2, source.tentative)
        s.born := i
        s.internal := Structure.new(up=not source.up, ref=source.ti, gate=i)
    found
method cancelSearch(ISSState s) =>
    bool wasRunning = s.running
    if wasRunning
        s.cancelled += 1
    s.running := false
    s.eligible := false
    wasRunning
method advance(ISSState s, int i, array<float> bodyHighs, array<float> bodyLows, float candleOpen, float candleClose, float previousOpen, float previousClose, float previousHigh, float previousLow, int candleCloseTime) =>
    int result = 0
    s.internalEvent := 0
    s.fifth := false
    s.allInside := false
    s.closeInside := false
    if s.running and i > s.born
        int ev = s.internal.step(i, bodyHighs, bodyLows, candleOpen, candleClose, previousOpen, previousClose, previousHigh, previousLow, candleCloseTime)
        s.internalEvent := ev
        bool bad = ev == 1 ? not f_in(s.internal.tentative, s.lower, s.upper) : ev == 2 ? not f_in(s.internal.ch, s.lower, s.upper) or not f_in(s.internal.cl, s.lower, s.upper) : false
        if bad
            s.running := false
            s.eligible := false
            s.rejected += 1
            array.clear(s.values)
            array.clear(s.origins)
            result := 3
        else
            result := ev == 1 or ev == 2 ? ev : 0
            if ev == 2 and s.eligible
                array.push(s.values, s.internal.up ? s.internal.ch : s.internal.cl)
                array.push(s.origins, s.internal.up ? s.internal.hi : s.internal.li)
                array.push(s.values, s.internal.up ? s.internal.cl : s.internal.ch)
                array.push(s.origins, s.internal.up ? s.internal.li : s.internal.hi)
            if ev == 1 and s.eligible and s.internal.pairs == 2 and array.size(s.values) == 4
                s.fifth := true
                s.allInside := f_in(s.internal.tentative, s.lower, s.upper)
                for n = 0 to 3
                    s.allInside := s.allInside and f_in(array.get(s.values, n), s.lower, s.upper)
                s.closeInside := f_in(candleClose, s.lower, s.upper)
                if s.allInside and s.closeInside
                    s.count += 1
                    s.confirmedAt := candleCloseTime
                    s.bullish := s.internal.up
                    s.running := false
                    s.eligible := false
                    result := 4
                else if not s.closeInside
                    s.outside += 1
                    s.eligible := false
                    result := 5
    result
type TJLRecord
    int serial = 0
    bool up = true
    int made = na
    int ready = na
    int p3 = na
    float p3price = na
    int ended = na
    string state = "Current set - newest confirmed pair"
    int highOrigin = na
    int lowOrigin = na
    float highUpper = na
    float highLower = na
    float lowUpper = na
    float lowLower = na
type TJLState
    TJLRecord newest = na
    TJLRecord current = na
    int seenPairs = 0
    int seenChoch = 0
    int omitted = 0
    int sets = 0
method synchronize(TJLState s, array<TJLRecord> records, Structure source, array<float> bodyHighs, array<float> bodyLows, array<float> wickHighs, array<float> wickLows, array<int> candleOpens, int pairCount, int chochEvents, int i, int candleCloseTime, int retainedPairs) =>
    if chochEvents > s.seenChoch
        if array.size(records) > 0
            for j = 0 to array.size(records) - 1
                TJLRecord r = array.get(records, j)
                if na(r.ended)
                    r.ended := candleCloseTime
                    r.state := "Invalidated by source CHOCH"
        s.current := na
        s.newest := na
    if pairCount > s.seenPairs
        if not na(s.current)
            s.current.ended := candleCloseTime
            s.current.state := "Replaced by newer confirmed pair"
        s.newest := TJLRecord.new(serial=pairCount, up=source.up, made=candleCloseTime, ready=candleCloseTime, highOrigin=array.get(candleOpens, source.hi), lowOrigin=array.get(candleOpens, source.li), highUpper=array.get(wickHighs, source.hi), highLower=array.get(bodyHighs, source.hi), lowUpper=array.get(bodyLows, source.li), lowLower=array.get(wickLows, source.li))
        s.current := s.newest
        s.sets += 1
        array.push(records, s.newest)
        while array.size(records) > retainedPairs
            TJLRecord dropped = array.shift(records)
            s.omitted += 1
    bool newPoint3 = source.pending and source.identified == i and source.known == candleCloseTime
    if newPoint3 and not na(s.newest)
        if s.newest.up == source.up and s.newest.serial == pairCount and na(s.newest.ended) and na(s.newest.p3)
            s.newest.p3 := array.get(candleOpens, source.ti)
            s.newest.p3price := source.tentative
    s.seenPairs := pairCount
    s.seenChoch := chochEvents
    true
// Scalar-only records: build fully before publication, never mutate afterwards.
// 10=main tentative,20=pair,30=CHOCH,40=ISS start,41=reject,42=tracking,
// 43=cancel,44=ISS confirmed,45/46=internal tentative/pair,47=clear internal,
// 49=no level2,50=TJL new,51=TJL end,52=TJL point3 metadata.
type CalcEvent
    string symbol = ""
    string tf = ""
    string id = ""
    int sequence = 0
    int kind = 0
    int serial = 0
    int sourceOpen = na
    int sourceClose = na
    int identifiedAt = na
    int previousCloseAt = na
    int o1 = na
    int o2 = na
    int o3 = na
    int o4 = na
    int o5 = na
    float p1 = na
    float p2 = na
    float p3 = na
    float p4 = na
    float p5 = na
    float h1 = na
    float l1 = na
    float h2 = na
    float l2 = na
    float h3 = na
    float l3 = na
    float h4 = na
    float l4 = na
    float h5 = na
    float l5 = na
    float barHigh = na
    float barLow = na
    float previousClose = na
    float completion = na
    float broken = na
    float lower = na
    float upper = na
    bool up = true
    bool allInside = false
    bool closeInside = false
    int reason = 0
    int made = na
    int ready = na
    int ended = na
f_event(string symbol, string tf, int kind, int serial, int sourceOpen, int sourceClose, float candleHigh, float candleLow, bool up) =>
    CalcEvent.new(symbol=symbol, tf=tf, kind=kind, serial=serial, sourceOpen=sourceOpen, sourceClose=sourceClose, barHigh=candleHigh, barLow=candleLow, up=up)
f_capture(CalcEvent e, int slot, int ix, bool highSide, array<float> bh, array<float> bl, array<float> wh, array<float> wl, array<int> times) =>
    int origin = array.get(times, ix)
    float price = highSide ? array.get(bh, ix) : array.get(bl, ix)
    float upper = highSide ? array.get(wh, ix) : array.get(bl, ix)
    float lower = highSide ? array.get(bh, ix) : array.get(wl, ix)
    if slot == 1
        e.o1 := origin
        e.p1 := price
        e.h1 := upper
        e.l1 := lower
    if slot == 2
        e.o2 := origin
        e.p2 := price
        e.h2 := upper
        e.l2 := lower
    if slot == 3
        e.o3 := origin
        e.p3 := price
        e.h3 := upper
        e.l3 := lower
    if slot == 4
        e.o4 := origin
        e.p4 := price
        e.h4 := upper
        e.l4 := lower
    if slot == 5
        e.o5 := origin
        e.p5 := price
        e.h5 := upper
        e.l5 := lower
    e
f_tjl_event(TJLRecord r, string symbol, string tf, int kind, int sourceOpen, int sourceClose, float candleHigh, float candleLow, int reason) =>
    CalcEvent e = f_event(symbol, tf, kind, r.serial, sourceOpen, sourceClose, candleHigh, candleLow, r.up)
    e.o1 := r.highOrigin
    e.o2 := r.lowOrigin
    e.p1 := r.highLower
    e.p2 := r.lowUpper
    e.h1 := r.highUpper
    e.l1 := r.highLower
    e.h2 := r.lowUpper
    e.l2 := r.lowLower
    e.o3 := r.p3
    e.p3 := r.p3price
    e.made := r.made
    e.ready := r.ready
    e.ended := r.ended
    e.reason := reason
    e
type ContextState
    Structure main = na
    ChochState choch = na
    ISSState iss = na
    TJLState tjl = na
    bool started = false
    bool halted = false
    int totalPairs = 0
    int skipped = 0
    int sequence = 0
    int firstOpen = na
    int lastClose = na
    string trend = "Waiting for start"
    int trendState = 0
    int trendStateSince = na
    string lastEvent = "None"
    string issStatus = "Waiting for main point 3"
f_context(bool up) =>
    ContextState.new(main=Structure.new(up=up), choch=ChochState.new(), iss=ISSState.new(internal=Structure.new(), values=array.new_float(), origins=array.new_int()), tjl=TJLState.new())
method publish(ContextState c, array<CalcEvent> batch, CalcEvent e) =>
    c.sequence += 1
    e.sequence := c.sequence
    e.id := e.symbol + "|" + e.tf + "|" + str.tostring(e.kind) + "|" + str.tostring(e.sourceClose) + "|" + str.tostring(e.o1) + "|" + str.tostring(e.o2)
    array.push(batch, e)
    true
// Calculation boundary: explicit source data/state/collections only. Caller must
// supply completed candles. No drawings, chart globals, barstate or view inputs.
method advanceContext(ContextState c, array<float> bh, array<float> bl, array<float> wh, array<float> wl, array<int> times, array<TJLRecord> records, array<CalcEvent> batch, string symbol, string tf, int selectedStart, int capacity, int retainedPairs, bool issEnabled, bool tjlEnabled, float candleOpen, float candleHigh, float candleLow, float candleClose, int sourceOpen, int sourceClose, float previousOpen, float previousHigh, float previousLow, float previousClose, int previousCloseAt) =>
    array.clear(batch)
    Structure m = c.main
    ISSState internal = c.iss
    if not c.started and sourceOpen == selectedStart
        c.started := true
        c.firstOpen := sourceOpen
        c.trend := m.up ? "Marking upward structure" : "Marking downward structure"
        c.trendState := 0
        c.trendStateSince := sourceClose
    if c.started and not c.halted
        if array.size(times) >= capacity
            c.halted := true
            c.lastEvent := "STOPPED: candle storage limit"
        else
            int before = array.size(times)
            array.push(bh, math.max(candleOpen, candleClose))
            array.push(bl, math.min(candleOpen, candleClose))
            array.push(wh, candleHigh)
            array.push(wl, candleLow)
            array.push(times, sourceOpen)
            int stored = array.size(times)
            if stored != before + 1 or array.size(bh) != stored or array.size(bl) != stored or array.size(wh) != stored or array.size(wl) != stored
                runtime.error("TopG candle-storage invariant failed")
            int i = stored - 1
            bool continuation = m.pending and i > m.identified and (m.up ? candleClose > m.tentative : candleClose < m.tentative)
            bool reversal = m.pending and not na(m.ch) and not na(m.cl) and (m.up ? candleClose < m.cl : candleClose > m.ch)
            if continuation and reversal and c.choch.run == 1
                c.halted := true
                c.lastEvent := "STOPPED: simultaneous continuation/CHOCH; review needed"
            else
                float oldHigh = m.ch
                float oldLow = m.cl
                int ev = m.step(i, bh, bl, candleOpen, candleClose, previousOpen, previousClose, previousHigh, previousLow, sourceClose)
                if ev == 3
                    c.skipped += 1
                if ev == 1
                    c.lastEvent := "Main point 3 identified"
                    CalcEvent e = f_event(symbol, tf, 10, c.totalPairs, sourceOpen, sourceClose, candleHigh, candleLow, m.up)
                    e.identifiedAt := m.known
                    f_capture(e, 1, m.ti, m.up, bh, bl, wh, wl, times)
                    c.publish(batch, e)
                if ev == 2
                    c.totalPairs += 1
                    if m.pairs >= 2
                        bool agrees = m.up ? m.ch > oldHigh and m.cl > oldLow : m.ch < oldHigh and m.cl < oldLow
                        c.trend := agrees ? (m.up ? "Upward trend" : "Downward trend") : "Trend not confirmed"
                        int newTrendState = agrees ? (m.up ? 1 : 2) : 0
                        if newTrendState != c.trendState
                            c.trendState := newTrendState
                            c.trendStateSince := sourceClose
                    c.lastEvent := "Pair " + str.tostring(c.totalPairs) + " confirmed"
                    CalcEvent e = f_event(symbol, tf, 20, c.totalPairs, sourceOpen, sourceClose, candleHigh, candleLow, m.up)
                    f_capture(e, 1, m.hi, true, bh, bl, wh, wl, times)
                    f_capture(e, 2, m.li, false, bh, bl, wh, wl, times)
                    c.publish(batch, e)
                bool changed = c.choch.evaluate(m, i, ev, candleClose, sourceClose)
                if changed
                    CalcEvent e = f_event(symbol, tf, 30, c.choch.count, sourceOpen, sourceClose, candleHigh, candleLow, not m.up)
                    e.identifiedAt := m.known
                    e.previousCloseAt := previousCloseAt
                    e.previousClose := previousClose
                    e.completion := candleClose
                    e.broken := m.up ? m.cl : m.ch
                    f_capture(e, 1, m.hi, true, bh, bl, wh, wl, times)
                    f_capture(e, 2, m.li, false, bh, bl, wh, wl, times)
                    f_capture(e, 3, m.ti, m.up, bh, bl, wh, wl, times)
                    c.publish(batch, e)
                    m.restartAfterChoch(i)
                    c.trend := m.up ? "Marking upward structure" : "Marking downward structure"
                    if c.trendState != 0
                        c.trendState := 0
                        c.trendStateSince := sourceClose
                    c.lastEvent := (c.choch.bullish ? "Bullish" : "Bearish") + " CHOCH " + str.tostring(c.choch.count)
                if ev == 2 or changed
                    bool wasRunning = internal.cancelSearch()
                    if wasRunning
                        c.issStatus := changed ? "Cancelled by main CHOCH" : "Cancelled by main continuation"
                        CalcEvent e = f_event(symbol, tf, 43, internal.candidates, sourceOpen, sourceClose, candleHigh, candleLow, m.up)
                        e.reason := changed ? 2 : 1
                        c.publish(batch, e)
                    c.publish(batch, f_event(symbol, tf, 47, internal.candidates, sourceOpen, sourceClose, candleHigh, candleLow, m.up))
                if ev == 1 and not changed and issEnabled
                    bool found = internal.beginSearch(m, i)
                    CalcEvent e = f_event(symbol, tf, found ? 40 : 49, internal.candidates, sourceOpen, sourceClose, candleHigh, candleLow, not m.up)
                    if found
                        c.issStatus := "Eligible: building internal structure"
                        e.lower := internal.lower
                        e.upper := internal.upper
                        f_capture(e, 1, m.up ? m.li : m.hi, not m.up, bh, bl, wh, wl, times)
                        f_capture(e, 2, m.ti, m.up, bh, bl, wh, wl, times)
                    else
                        c.issStatus := "No confirmed main level 2 yet"
                    c.publish(batch, e)
                if internal.running and i > internal.born
                    int outcome = internal.advance(i, bh, bl, candleOpen, candleClose, previousOpen, previousClose, previousHigh, previousLow, sourceClose)
                    Structure s = internal.internal
                    int iev = internal.internalEvent
                    if outcome == 3
                        c.issStatus := "Rejected: internal marked price outside range"
                        CalcEvent e = f_event(symbol, tf, 41, internal.candidates, sourceOpen, sourceClose, candleHigh, candleLow, s.up)
                        e.reason := iev
                        if iev == 1
                            f_capture(e, 1, s.ti, s.up, bh, bl, wh, wl, times)
                        else
                            f_capture(e, 1, s.hi, true, bh, bl, wh, wl, times)
                            f_capture(e, 2, s.li, false, bh, bl, wh, wl, times)
                        c.publish(batch, e)
                    else
                        if iev == 1 or iev == 2
                            CalcEvent e = f_event(symbol, tf, iev == 1 ? 45 : 46, s.pairs, sourceOpen, sourceClose, candleHigh, candleLow, s.up)
                            if iev == 1
                                f_capture(e, 1, s.ti, s.up, bh, bl, wh, wl, times)
                            else
                                f_capture(e, 1, s.hi, true, bh, bl, wh, wl, times)
                                f_capture(e, 2, s.li, false, bh, bl, wh, wl, times)
                            c.publish(batch, e)
                        if internal.fifth
                            CalcEvent e = f_event(symbol, tf, outcome == 4 ? 44 : 42, outcome == 4 ? internal.count : internal.candidates, sourceOpen, sourceClose, candleHigh, candleLow, s.up)
                            e.lower := internal.lower
                            e.upper := internal.upper
                            e.completion := candleClose
                            e.allInside := internal.allInside
                            e.closeInside := internal.closeInside
                            for n = 0 to 3
                                f_capture(e, n + 1, array.get(internal.origins, n), n % 2 == 0 ? s.up : not s.up, bh, bl, wh, wl, times)
                            f_capture(e, 5, s.ti, s.up, bh, bl, wh, wl, times)
                            c.publish(batch, e)
                            c.issStatus := outcome == 4 ? "Confirmed " + (s.up ? "Bullish" : "Bearish") + " ISS; search ended" : "Tracking ONLY: outside-range completion close"
                if not issEnabled
                    c.issStatus := "ISS scope: switch to H1 / M5 / M1"
                if tjlEnabled
                    TJLRecord prior = c.tjl.current
                    int oldSets = c.tjl.sets
                    bool hadP3 = not na(prior) ? not na(prior.p3) : false
                    c.tjl.synchronize(records, m, bh, bl, wh, wl, times, c.totalPairs, c.choch.count, i, sourceClose, retainedPairs)
                    if not na(prior)
                        if not na(prior.ended) and prior.ended == sourceClose
                            c.publish(batch, f_tjl_event(prior, symbol, tf, 51, sourceOpen, sourceClose, candleHigh, candleLow, changed ? 2 : 1))
                    if c.tjl.sets > oldSets
                        c.publish(batch, f_tjl_event(c.tjl.current, symbol, tf, 50, sourceOpen, sourceClose, candleHigh, candleLow, 0))
                    else if not hadP3 and not na(c.tjl.current)
                        if not na(c.tjl.current.p3)
                            c.publish(batch, f_tjl_event(c.tjl.current, symbol, tf, 52, sourceOpen, sourceClose, candleHigh, candleLow, 0))
                    int retained = array.size(records)
                    if retained != math.min(c.tjl.sets, retainedPairs) or c.tjl.omitted + retained != c.tjl.sets
                        runtime.error("TopG TJL retention invariant failed")
                    if not na(c.tjl.current)
                        if retained == 0
                            runtime.error("TopG current TJL has no retained record")
                        else
                            TJLRecord r = array.get(records, retained - 1)
                            if r.serial != c.tjl.current.serial or not na(r.ended)
                                runtime.error("TopG current TJL and retained record disagree")
                c.lastClose := sourceClose
    not c.halted
// Everything below is native-chart presentation/adaptation, not calculation.
f_time(int stamp) =>
    na(stamp) ? "None" : str.format_time(stamp, "yyyy-MM-dd HH:mm", syminfo.timezone)
f_price(float price) =>
    str.tostring(price, format.mintick)
f_clear_points(array<line> ls, array<label> lbs) =>
    while array.size(ls) > 0
        line.delete(array.shift(ls))
        label.delete(array.shift(lbs))
f_trim_points(array<line> ls, array<label> lbs, int cap) =>
    int removed = 0
    while array.size(ls) > cap
        line.delete(array.shift(ls))
        label.delete(array.shift(lbs))
        removed += 1
    removed
f_point(array<line> ls, array<label> lbs, int origin, float price, int known, bool highSide, string caption, color ink, bool dashed) =>
    line ln = line.new(origin, price, known, price, xloc=xloc.bar_time, extend=extend.right, color=ink, style=dashed ? line.style_dashed : line.style_solid)
    label lb = label.new(origin, price, caption, xloc=xloc.bar_time, style=highSide ? label.style_label_down : label.style_label_up, color=ink, textcolor=color.white, size=size.tiny)
    label.set_tooltip(lb, "Origin OPEN: " + f_time(origin) + "\nKnown at close: " + f_time(known) + "\nPrice: " + f_price(price))
    array.push(ls, ln)
    array.push(lbs, lb)
f_ztrim(array<box> bs, array<line> ls, array<label> lbs, int cap) =>
    int removed = 0
    while array.size(lbs) > cap
        box.delete(array.shift(bs))
        line.delete(array.shift(ls))
        label.delete(array.shift(lbs))
        removed += 1
    removed
f_zone(array<box> bs, array<line> ls, array<label> lbs, int origin, float upper, float lower, bool highSide, int known, string caption, color ink) =>
    box bx = na
    line ln = na
    if upper > lower
        bx := box.new(left=origin, top=upper, right=known, bottom=lower, xloc=xloc.bar_time, extend=extend.right, border_color=ink, bgcolor=color.new(ink, 88))
    else
        ln := line.new(origin, lower, known, lower, xloc=xloc.bar_time, extend=extend.right, color=ink, width=2)
    label lb = label.new(origin, highSide ? upper : lower, caption, xloc=xloc.bar_time, style=highSide ? label.style_label_down : label.style_label_up, color=ink, textcolor=color.white, size=size.tiny)
    label.set_tooltip(lb, "Origin OPEN: " + f_time(origin) + "\nConfirmed at close: " + f_time(known) + "\nZone: " + f_price(lower) + " to " + f_price(upper) + "\nAnalysis zone, NOT a trade entry")
    array.push(bs, bx)
    array.push(ls, ln)
    array.push(lbs, lb)
f_marker(array<label> a, CalcEvent e, string caption, string detail, bool bullish, color ink, int cap) =>
    label lb = label.new(e.sourceOpen, bullish ? e.barLow : e.barHigh, caption, xloc=xloc.bar_time, style=bullish ? label.style_label_up : label.style_label_down, color=ink, textcolor=color.white, size=size.tiny)
    label.set_tooltip(lb, detail + "\nEvent ID: " + e.id)
    array.push(a, lb)
    int removed = 0
    while array.size(a) > cap
        label.delete(array.shift(a))
        removed += 1
    removed
f_tjl_detail(TJLRecord r) =>
    string detail = "TJL pair #" + str.tostring(r.serial) + " | " + syminfo.tickerid + " | " + timeframe.period + "\nTimes: " + syminfo.timezone + "\nDirection: " + (r.up ? "Bullish" : "Bearish") + "\nStatus: " + r.state
    detail += "\nStructurally marked at close: " + f_time(r.made) + "\nCurrent set available at close: " + f_time(r.ready)
    detail += "\nSubsequent point 3 origin (optional): " + f_time(r.p3) + " | " + f_price(r.p3price) + "\nSet ended at close: " + f_time(r.ended)
    detail += "\nTJL1 source OPEN: " + f_time(r.up ? r.highOrigin : r.lowOrigin) + "\nTJL2 source OPEN: " + f_time(r.up ? r.lowOrigin : r.highOrigin)
    detail += "\nD-006: newest confirmed pair immediately current.\nNo tap/usage/entry engine. Start dependence unresolved."
    detail
f_tjl_draw(array<box> bs, array<line> ls, array<label> lbs, TJLRecord r, bool first) =>
    bool highSide = first ? r.up : not r.up
    int origin = highSide ? r.highOrigin : r.lowOrigin
    float upper = highSide ? r.highUpper : r.lowUpper
    float lower = highSide ? r.highLower : r.lowLower
    bool live = na(r.ended)
    int rightEdge = live ? time_close : r.ended
    color ink = not live ? color.gray : r.up ? color.green : color.maroon
    string caption = (first ? "TJL1" : "TJL2 / A+") + " #" + str.tostring(r.serial) + " | " + (live ? "current set" : "historical")
    box bx = na
    line ln = na
    if upper > lower
        bx := box.new(left=origin, top=upper, right=rightEdge, bottom=lower, xloc=xloc.bar_time, extend=live ? extend.right : extend.none, border_color=ink, bgcolor=color.new(ink, 88))
    else
        ln := line.new(origin, lower, rightEdge, lower, xloc=xloc.bar_time, extend=live ? extend.right : extend.none, color=ink, width=2)
    label lb = label.new(origin, highSide ? upper : lower, caption, xloc=xloc.bar_time, style=highSide ? label.style_label_down : label.style_label_up, color=ink, textcolor=color.white, size=size.tiny)
    string identity = syminfo.tickerid + "|" + timeframe.period + "|" + (r.up ? "BULL|" : "BEAR|") + (highSide ? "H|" : "L|") + str.tostring(origin)
    label.set_tooltip(lb, f_tjl_detail(r) + "\nLevel ID: " + identity + "\nZone: " + f_price(lower) + " to " + f_price(upper))
    array.push(bs, bx)
    array.push(ls, ln)
    array.push(lbs, lb)
var array<float> tops = array.new_float()
var array<float> bots = array.new_float()
var array<float> wh = array.new_float()
var array<float> wl = array.new_float()
var array<int> ts = array.new_int()
var array<TJLRecord> engineRecords = array.new<TJLRecord>()
var array<CalcEvent> batch = array.new<CalcEvent>()
var ContextState ctx = f_context(initialDir == "Upward")
// Presentation cache contains copies, never calculation objects or mutable events.
var array<TJLRecord> displayRecords = array.new<TJLRecord>()
var array<line> ml = array.new_line()
var array<label> mb = array.new_label()
var array<label> me = array.new_label()
var array<box> cb = array.new_box()
var array<line> cln = array.new_line()
var array<label> cz = array.new_label()
var array<label> ce = array.new_label()
var array<box> ib = array.new_box()
var array<line> iln = array.new_line()
var array<label> iz = array.new_label()
var array<label> ie = array.new_label()
var array<line> dl = array.new_line()
var array<label> db = array.new_label()
var array<box> tjb = array.new_box()
var array<line> tjl = array.new_line()
var array<label> tjz = array.new_label()
var line tentativeLine = na
var label tentativeLabel = na
var line itl = na
var label itb = na
var int omittedPoints = 0
var int omittedZones = 0
var int omittedEvents = 0
var string chochAudit = "No confirmed CHOCH."
var string issAudit = "No ISS candidate."
var string lastEventID = "None"
var int lastBatchSize = 0
var table panel = table.new(position.top_right, 2, 17, border_width=1, border_color=color.gray)
var table audit = table.new(position.bottom_right, 1, 1, border_width=1, border_color=color.gray)
var table tjPanel = table.new(position.bottom_left, 2, 7, border_width=1, border_color=color.gray)
var table eventPanel = table.new(position.bottom_center, 2, 4, border_width=1, border_color=color.gray)
bool issScope = timeframe.isminutes and (timeframe.multiplier == 60 or timeframe.multiplier == 5 or timeframe.multiplier == 1)
bool tjlScope = (timeframe.isdaily and timeframe.multiplier == 1) or (timeframe.isminutes and (timeframe.multiplier == 240 or timeframe.multiplier == 60))
if barstate.isconfirmed and not auditRequested and not combined
    bool processed = ctx.advanceContext(tops, bots, wh, wl, ts, engineRecords, batch, syminfo.tickerid, timeframe.period, start, limit, keepTJL, issScope, tjlScope, open, high, low, close, time, time_close, open[1], high[1], low[1], close[1], time_close[1])
    lastBatchSize := array.size(batch)
    if array.size(batch) > 0
        for j = 0 to array.size(batch) - 1
            CalcEvent e = array.get(batch, j)
            lastEventID := e.id
            if e.kind == 10
                if msmView != "Off"
                    f_point(ml, mb, e.o1, e.p1, e.sourceClose, e.up, e.up ? "TH pending" : "TL pending", color.orange, true)
                    tentativeLine := array.pop(ml)
                    tentativeLabel := array.pop(mb)
                if showEvents and msmView != "Off"
                    omittedEvents += f_marker(me, e, "POINT IDENTIFIED", "Main point 3 identified at " + f_time(e.sourceClose), true, color.orange, msmView == "Latest" ? 1 : 40)
            if e.kind == 20 or e.kind == 30
                line.delete(tentativeLine)
                label.delete(tentativeLabel)
                tentativeLine := na
                tentativeLabel := na
            if e.kind == 20
                if msmView == "Latest"
                    f_clear_points(ml, mb)
                if msmView != "Off"
                    f_point(ml, mb, e.o1, e.p1, e.sourceClose, true, "CH " + str.tostring(e.serial), color.red, false)
                    f_point(ml, mb, e.o2, e.p2, e.sourceClose, false, "CL " + str.tostring(e.serial), color.teal, false)
                    omittedPoints += f_trim_points(ml, mb, keepPoints)
                if showEvents and msmView != "Off"
                    omittedEvents += f_marker(me, e, "PAIR CONFIRMED", "Pair " + str.tostring(e.serial) + " confirmed at " + f_time(e.sourceClose), false, color.blue, msmView == "Latest" ? 1 : 40)
            if e.kind == 30
                string side = e.up ? "Bullish" : "Bearish"
                chochAudit := side + " CHOCH #" + str.tostring(e.serial) + " | " + e.symbol + " | " + e.tf + "\nTimes: " + syminfo.timezone
                chochAudit += "\nBroken level: " + f_price(e.broken) + "\nClose 1: " + f_time(e.previousCloseAt) + " | " + f_price(e.previousClose) + "\nClose 2: " + f_time(e.sourceClose) + " | " + f_price(e.completion)
                chochAudit += "\nRequired: both strictly " + (e.up ? "above" : "below") + "; adjacent candles\nPoint 3 origin: " + f_time(e.o3) + " | " + f_price(e.p3)
                chochAudit += "\nPoint 3 identified: " + f_time(e.identifiedAt) + "\nEligible by close 1: " + (e.identifiedAt <= e.previousCloseAt ? "YES" : "NO") + "\nRestart reference OPEN: " + f_time(e.o3)
                if chochView != "Off"
                    if chochView == "Latest"
                        int unused = f_ztrim(cb, cln, cz, 0)
                    color ink = e.up ? color.green : color.maroon
                    string tag = " #" + str.tostring(e.serial)
                    f_zone(cb, cln, cz, e.o2, e.h2, e.l2, false, e.sourceClose, (e.up ? "QML / A+" : "SBR") + tag, ink)
                    f_zone(cb, cln, cz, e.o1, e.h1, e.l1, true, e.sourceClose, (e.up ? "RBS" : "QML / A+") + tag, ink)
                    f_zone(cb, cln, cz, e.o3, e.h3, e.l3, not e.up, e.sourceClose, (e.up ? "Double bottom" : "Double top") + tag, ink)
                    omittedZones += f_ztrim(cb, cln, cz, keepChoch * 3)
                    if showEvents
                        omittedEvents += f_marker(ce, e, side + " CHOCH" + tag, chochAudit, e.up, ink, chochView == "Latest" ? 1 : keepChoch)
            if e.kind == 40 or e.kind == 41 or e.kind == 47 or e.kind == 49
                f_clear_points(dl, db)
                line.delete(itl)
                label.delete(itb)
                itl := na
                itb := na
            if e.kind == 40
                issAudit := "Candidate #" + str.tostring(e.serial) + " | " + e.symbol + " | " + e.tf + "\nTimes: " + syminfo.timezone + "\nStarted at close: " + f_time(e.sourceClose)
                issAudit += "\nFixed inclusive range: " + f_price(e.lower) + " to " + f_price(e.upper) + "\nMain level 2 origin: " + f_time(e.o1) + "\nMain level 3 origin: " + f_time(e.o2)
            if e.kind == 41
                issAudit += "\nRejected: internal marked price outside range at " + f_time(e.sourceClose)
                issAudit += e.reason == 1 ? "\nRejected tentative price: " + f_price(e.p1) : "\nRejected pair high/low: " + f_price(e.p1) + " / " + f_price(e.p2)
            if e.kind == 43
                issAudit += "\nCancelled by main " + (e.reason == 2 ? "CHOCH" : "continuation") + " at " + f_time(e.sourceClose)
            if e.kind == 46
                line.delete(itl)
                label.delete(itb)
                itl := na
                itb := na
                if showInternal and issView != "Off"
                    f_point(dl, db, e.o1, e.p1, e.sourceClose, true, "iCH " + str.tostring(e.serial), color.purple, false)
                    f_point(dl, db, e.o2, e.p2, e.sourceClose, false, "iCL " + str.tostring(e.serial), color.purple, false)
                    omittedPoints += f_trim_points(dl, db, 20)
            if e.kind == 45 and showInternal and issView != "Off"
                f_point(dl, db, e.o1, e.p1, e.sourceClose, e.up, "iTentative", color.purple, true)
                itl := array.pop(dl)
                itb := array.pop(db)
            if e.kind == 42 or e.kind == 44
                issAudit += "\nFifth point identified at close: " + f_time(e.sourceClose)
                issAudit += "\nInternal P1: " + f_price(e.p1) + " | origin " + f_time(e.o1) + "\nInternal P2: " + f_price(e.p2) + " | origin " + f_time(e.o2)
                issAudit += "\nInternal P3: " + f_price(e.p3) + " | origin " + f_time(e.o3) + "\nInternal P4: " + f_price(e.p4) + " | origin " + f_time(e.o4)
                issAudit += "\nInternal P5 tentative: " + f_price(e.p5) + " | origin " + f_time(e.o5) + "\nCompletion close: " + f_price(e.completion)
                issAudit += "\nAll five in range: " + (e.allInside ? "YES" : "NO") + "\nCompletion close in range: " + (e.closeInside ? "YES" : "NO")
                if e.kind == 44
                    string side = e.up ? "Bullish" : "Bearish"
                    issAudit += "\nCONFIRMED " + side + " ISS #" + str.tostring(e.serial) + "\nZones use internal P3 and P4. No additional main CHOCH required."
                    if issView != "Off"
                        if issView == "Latest"
                            int unused = f_ztrim(ib, iln, iz, 0)
                        string tag = " ISS #" + str.tostring(e.serial)
                        color ink = e.up ? color.teal : color.fuchsia
                        f_zone(ib, iln, iz, e.o3, e.h3, e.l3, e.up, e.sourceClose, (e.up ? "RBS" : "SBR") + tag, ink)
                        f_zone(ib, iln, iz, e.o4, e.h4, e.l4, not e.up, e.sourceClose, (e.up ? "Buying A+" : "Selling A+") + tag, ink)
                        omittedZones += f_ztrim(ib, iln, iz, keepISS * 2)
                        if showEvents
                            omittedEvents += f_marker(ie, e, side + " ISS #" + str.tostring(e.serial), issAudit, e.up, ink, issView == "Latest" ? 1 : keepISS)
                else
                    issAudit += "\nNO ISS. Eligibility permanently lost for this main point 3; internal tracking continues."
            if e.kind == 50
                TJLRecord r = TJLRecord.new(serial=e.serial, up=e.up, made=e.made, ready=e.ready, p3=e.o3, p3price=e.p3, highOrigin=e.o1, lowOrigin=e.o2, highUpper=e.h1, highLower=e.l1, lowUpper=e.h2, lowLower=e.l2)
                array.push(displayRecords, r)
                while array.size(displayRecords) > keepTJL
                    TJLRecord dropped = array.shift(displayRecords)
            if e.kind == 51 or e.kind == 52
                if array.size(displayRecords) > 0
                    for k = 0 to array.size(displayRecords) - 1
                        TJLRecord r = array.get(displayRecords, k)
                        if r.serial == e.serial
                            if e.kind == 51
                                r.ended := e.ended
                                r.state := e.reason == 2 ? "Invalidated by source CHOCH" : "Replaced by newer confirmed pair"
                            else
                                r.p3 := e.o3
                                r.p3price := e.p3
    if tjlScope and ctx.started and not ctx.halted
        if array.size(displayRecords) != array.size(engineRecords)
            runtime.error("TopG event-render TJL retention mismatch")
if barstate.islast and not auditRequested and not combined
    Structure m = ctx.main
    ChochState ch = ctx.choch
    ISSState ins = ctx.iss
    string state = ctx.halted ? "HALTED: see last event" : not ctx.started ? "Start not found: select loaded candle OPEN" : m.pending ? "Waiting: continuation or CHOCH" : "Searching for pullback"
    array<string> keys = array.from("TopG v0.5.1-dev", "State", "Current direction / chart", "Structure", "Pairs: total / direction", "Confirmed high / low", "Tentative / CHOCH closes", "CHOCH count / side", "Last CHOCH close", "ISS state", "ISS count / last side", "Last ISS close", "ISS rejected / outside close / cancelled", "Candles / empty pairs skipped", "Omitted points / zones / markers", "Last main event", "Scope")
    array<string> vals = array.from("MSM CHOCH ISS TJL / UNVERIFIED", state, (m.up ? "Upward" : "Downward") + " / " + timeframe.period, ctx.trend, str.tostring(ctx.totalPairs) + " / " + str.tostring(m.pairs), f_price(m.ch) + " / " + f_price(m.cl), f_price(m.tentative) + " / " + str.tostring(ch.run), str.tostring(ch.count) + " / " + (ch.count == 0 ? "None" : ch.bullish ? "Bullish" : "Bearish"), f_time(ch.confirmedAt), ctx.issStatus, str.tostring(ins.count) + " / " + (ins.count == 0 ? "None" : ins.bullish ? "Bullish" : "Bearish"), f_time(ins.confirmedAt), str.tostring(ins.rejected) + " / " + str.tostring(ins.outside) + " / " + str.tostring(ins.cancelled), str.tostring(array.size(ts)) + " / " + str.tostring(ctx.skipped), str.tostring(omittedPoints) + " / " + str.tostring(omittedZones) + " / " + str.tostring(omittedEvents), ctx.lastEvent, "Native mode; chart window controlled by Calculated bars (verify externally, limit " + str.tostring(limit) + "). Combined audit opt-in; no entries")
    for row = 0 to 16
        table.cell(panel, 0, row, array.get(keys, row), bgcolor=color.white, text_color=color.black, text_size=size.small)
        table.cell(panel, 1, row, array.get(vals, row), bgcolor=color.white, text_color=color.black, text_size=size.small)
    int deleted = f_ztrim(tjb, tjl, tjz, 0)
    TJLRecord currentDisplay = na
    if array.size(displayRecords) > 0
        for j = 0 to array.size(displayRecords) - 1
            TJLRecord r = array.get(displayRecords, j)
            if na(r.ended)
                currentDisplay := r
            if tjlScope and tjlView != "Off" and (tjlView == "History" or na(r.ended))
                f_tjl_draw(tjb, tjl, tjz, r, true)
                f_tjl_draw(tjb, tjl, tjz, r, false)
    string tjStatus = not tjlScope ? "TJL: use D1 / H4 / H1" : ctx.halted ? "HALTED: TJL history incomplete" : not ctx.started ? "Waiting for selected start" : na(currentDisplay) ? "No current confirmed-pair set" : "Current set #" + str.tostring(currentDisplay.serial)
    array<string> tk = array.from("TJL - chart timeframe", "Latest confirmed pair", "Current set available", "Sets created / source trend", "Historical pairs omitted", "Green / maroon / gray", "Execution status")
    array<string> tv = array.from(tjStatus, na(currentDisplay) ? "None" : "Pair #" + str.tostring(currentDisplay.serial) + " / " + currentDisplay.state, na(currentDisplay) ? "None" : f_time(currentDisplay.ready), str.tostring(ctx.tjl.sets) + " sets / " + ctx.trend, str.tostring(ctx.tjl.omitted), "Bullish current / bearish current / historical", "No taps / usage / Buy-Sell yet")
    for row = 0 to 6
        table.cell(tjPanel, 0, row, array.get(tk, row), bgcolor=color.white, text_color=color.black, text_size=size.small)
        table.cell(tjPanel, 1, row, array.get(tv, row), bgcolor=color.white, text_color=color.black, text_size=size.small)
    if showTJLAudit or showISSAudit or showAudit
        string report = showTJLAudit ? (na(currentDisplay) ? "No current TJL record. " + tjStatus : f_tjl_detail(currentDisplay)) : showISSAudit ? issAudit : chochAudit
        table.cell(audit, 0, 0, report, bgcolor=color.white, text_color=color.black, text_halign=text.align_left, text_size=size.small)
    else
        table.clear(audit, 0, 0, 0, 0)
    if showCalcAudit
        array<string> ek = array.from("Events emitted / last batch", "First source OPEN", "Last processed source CLOSE", "Latest event ID")
        array<string> ev = array.from(str.tostring(ctx.sequence) + " / " + str.tostring(lastBatchSize), f_time(ctx.firstOpen), f_time(ctx.lastClose), lastEventID)
        for row = 0 to 3
            table.cell(eventPanel, 0, row, array.get(ek, row), bgcolor=color.white, text_color=color.black, text_size=size.tiny)
            table.cell(eventPanel, 1, row, array.get(ev, row), bgcolor=color.white, text_color=color.black, text_size=size.tiny)
    else
        table.clear(eventPanel, 0, 0, 1, 3)

// v0.4.9: selected D1/H4/H1/M5 source audit; retained batch IDs only.
// The shared detector above is unchanged. No collections cross the request.
type H1Audit
    string report = ""
    int sourceClose = na
    int sequence = 0
    int batchSize = 0
    int retainedClose = na
    int retainedSize = 0
    string retainedIDs = "None"
f_h1_audit(ContextState c, int candles, array<CalcEvent> events) =>
    // Function-local cache is independent in native and requested contexts.
    // Empty source candles do not erase it; reload rebuilds it from history.
    var int retainedClose = na
    var int retainedSize = 0
    var string retainedIDs = "None"
    Structure m = c.main
    string r = (c.halted ? "HALTED" : c.started ? "Started" : "START NOT FOUND: check selected source reference/history") + " | " + c.trend
    r += "\nFirst source OPEN: " + f_time(c.firstOpen) + "\nLast processed CLOSE: " + f_time(c.lastClose)
    r += "\nCandles / skipped: " + str.tostring(candles) + " / " + str.tostring(c.skipped)
    r += "\nDirection: " + (m.up ? "Upward" : "Downward") + " | Pairs total/direction: " + str.tostring(c.totalPairs) + "/" + str.tostring(m.pairs)
    r += "\nHigh / low / tentative: " + f_price(m.ch) + " / " + f_price(m.cl) + " / " + f_price(m.tentative)
    r += "\nCHOCH count / run / side: " + str.tostring(c.choch.count) + " / " + str.tostring(c.choch.run) + " / " + (c.choch.count == 0 ? "None" : c.choch.bullish ? "Bullish" : "Bearish") + " | " + f_time(c.choch.confirmedAt)
    r += "\nISS: " + c.issStatus + "\nISS count / side / close: " + str.tostring(c.iss.count) + " / " + (c.iss.count == 0 ? "None" : c.iss.bullish ? "Bullish" : "Bearish") + " / " + f_time(c.iss.confirmedAt)
    r += "\nISS candidates/rejected/outside/cancelled: " + str.tostring(c.iss.candidates) + "/" + str.tostring(c.iss.rejected) + "/" + str.tostring(c.iss.outside) + "/" + str.tostring(c.iss.cancelled)
    r += "\nTJL sets: " + str.tostring(c.tjl.sets)
    TJLRecord t = c.tjl.current
    if not na(t)
        r += " | Current #" + str.tostring(t.serial) + " | " + (t.up ? "Bullish" : "Bearish") + " | Ready: " + f_time(t.ready)
        r += "\nHigh origin/zone: " + f_time(t.highOrigin) + " / " + f_price(t.highLower) + " to " + f_price(t.highUpper)
        r += "\nLow origin/zone: " + f_time(t.lowOrigin) + " / " + f_price(t.lowLower) + " to " + f_price(t.lowUpper)
        r += "\nTJL point3 origin/price: " + f_time(t.p3) + " / " + f_price(t.p3price)
    else
        r += " | No current set"
    r += "\nCalculation events / this batch: " + str.tostring(c.sequence) + " / " + str.tostring(array.size(events))
    if array.size(events) > 0
        retainedClose := c.lastClose
        retainedSize := array.size(events)
        retainedIDs := ""
        for n = 0 to array.size(events) - 1
            CalcEvent e = array.get(events, n)
            string eventLine = str.tostring(e.sequence) + ": " + e.id
            r += "\n" + eventLine
            retainedIDs += (n == 0 ? "" : "\n") + eventLine
    r += "\nRetained nonempty batch CLOSE / size: " + f_time(retainedClose) + " / " + str.tostring(retainedSize)
    r += "\nRetained event sequence / IDs:\n" + retainedIDs
    r += "\nLast main event: " + c.lastEvent
    H1Audit.new(report=r, sourceClose=c.lastClose, sequence=c.sequence, batchSize=array.size(events), retainedClose=retainedClose, retainedSize=retainedSize, retainedIDs=retainedIDs)
f_h1_requested(int reference, bool up, int capacity, int retained, string sourceTF, bool sourceISS, bool sourceTJL) =>
    var ContextState c = f_context(up)
    var array<float> bh = array.new_float()
    var array<float> bl = array.new_float()
    var array<float> highs = array.new_float()
    var array<float> lows = array.new_float()
    var array<int> opens = array.new_int()
    var array<TJLRecord> records = array.new<TJLRecord>()
    var array<CalcEvent> events = array.new<CalcEvent>()
    bool processed = c.advanceContext(bh, bl, highs, lows, opens, records, events, syminfo.tickerid, sourceTF, reference, capacity, retained, sourceISS, sourceTJL, open, high, low, close, time, time_close, open[1], high[1], low[1], close[1], time_close[1])
    f_h1_audit(c, array.size(opens), events)
bool h1Native = auditNative
bool h1Requested = auditRequested
bool auditTFMatches = auditTF == "1D" ? timeframe.isdaily and timeframe.multiplier == 1 : timeframe.isminutes and timeframe.multiplier == int(str.tonumber(auditTF))
if h1Native and not auditTFMatches
    runtime.error("Native audit requires the selected source chart: " + auditTF)
if h1Requested and not (timeframe.isminutes and timeframe.multiplier == 1)
    runtime.error("Requested source audit requires an M1 chart.")
// Snapshot fresh scalar fields; offset the WHOLE source snapshot by one bar.
// Never use barstate.isconfirmed inside security or expose a developing packet.
H1Audit nativeH1 = h1Native ? f_h1_audit(ctx, array.size(ts), batch) : na
H1Audit receivedH1 = na
if h1Requested
    receivedH1 := request.security(syminfo.tickerid, auditTF, f_h1_requested(start, initialDir == "Upward", limit, keepTJL, auditTF, auditTF == "60" or auditTF == "5", auditTF != "5")[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
H1Audit h1Packet = h1Native ? nativeH1[1] : receivedH1
varip int h1SeenClose = na
varip int h1SeenSequence = na
varip int h1ObservedOpen = na
varip int h1ObservedLive = na
varip string h1Coverage = "Initial sample: prior delivery history not verified"
if h1Requested and not na(h1Packet)
    if not na(h1Packet.sourceClose) and (na(h1SeenClose) or h1Packet.sourceClose != h1SeenClose)
        if h1Packet.sourceClose > time
            runtime.error("Source audit received a future source close.")
        if not na(h1SeenSequence)
            h1Coverage := h1Packet.sequence - h1SeenSequence == h1Packet.batchSize ? "Latest transition event count consistent" : "WARNING: intervening event batches may be missing"
        h1SeenClose := h1Packet.sourceClose
        h1SeenSequence := h1Packet.sequence
        h1ObservedOpen := time
        h1ObservedLive := barstate.isrealtime ? timenow : na
var table h1Panel = table.new(position.top_left, 1, 3, border_width=1, border_color=color.gray)
if barstate.islast and h1Diagnostic != "Off"
    string heading = "TopG v0.5.1-dev | " + h1Diagnostic + " | Source TF: " + auditTF + " | Times: " + syminfo.timezone
    table.cell(h1Panel, 0, 0, heading, bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(h1Panel, 0, 1, na(h1Packet) ? "Waiting for previous completed source snapshot" : h1Packet.report, bgcolor=color.white, text_color=color.black, text_halign=text.align_left, text_size=size.small)
    string delivery = h1Requested ? "Observed M1 OPEN: " + f_time(h1ObservedOpen) + " | LIVE: " + f_time(h1ObservedLive) + "\n" + h1Coverage : "Native baseline: previous completed source snapshot"
    table.cell(h1Panel, 0, 2, delivery + "\nSingle-source audit: use that source candle OPEN/direction in Initialization. Retained IDs are the latest batch, not a complete event stream. This single-source panel displays IDs only; combined mode transports full payloads. No taps or entries. Chart window controlled by Calculated bars (verify externally, limit " + str.tostring(limit) + "); source request count sourceBars + 2 (" + str.tostring(sourceBars + 2) + "). Compare source close, retained batch close and identical inputs. Start dependence unresolved; runtime/replay/reload UNVERIFIED.", bgcolor=color.white, text_color=color.black, text_halign=text.align_left, text_size=size.tiny)


// Complete scalar wire codec. Percent escaping keeps string fields unambiguous.
// Column order is exactly the existing 44-field CalcEvent declaration.
f_ws(string v) =>
    str.replace_all(str.replace_all(str.replace_all(v, "%", "%25"), ",", "%2C"), ";", "%3B")
f_wus(string v) =>
    str.replace_all(str.replace_all(str.replace_all(v, "%3B", ";"), "%2C", ","), "%25", "%")
f_wi(int v) =>
    na(v) ? "~" : str.tostring(v)
f_wf(float v) =>
    string s = na(v) ? "~" : str.tostring(v, "#.################")
    if not na(v) and str.tonumber(s) != v
        runtime.error("Event float failed numeric round-trip")
    s
f_wb(bool v) =>
    v ? "1" : "0"
f_wn(array<string> a, int i) =>
    string s = array.get(a, i)
    float n = s == "~" ? na : str.tonumber(s)
    if s != "~" and na(n)
        runtime.error("Invalid numeric wire field")
    n
f_wint(array<string> a, int i) =>
    float n = f_wn(a, i)
    if not na(n)
        if math.abs(n) > 9007199254740991 or n != int(n)
            runtime.error("Invalid or inexact integer wire field")
    int(n)
f_wbool(array<string> a, int i) =>
    string s = array.get(a, i)
    if s != "0" and s != "1"
        runtime.error("Invalid boolean wire field")
    s == "1"
f_wire(CalcEvent e) =>
    array<string> a = array.from(f_ws(e.symbol), f_ws(e.tf), f_ws(e.id), f_wi(e.sequence), f_wi(e.kind), f_wi(e.serial), f_wi(e.sourceOpen), f_wi(e.sourceClose), f_wi(e.identifiedAt), f_wi(e.previousCloseAt), f_wi(e.o1), f_wi(e.o2), f_wi(e.o3), f_wi(e.o4), f_wi(e.o5), f_wf(e.p1), f_wf(e.p2), f_wf(e.p3), f_wf(e.p4), f_wf(e.p5), f_wf(e.h1), f_wf(e.l1), f_wf(e.h2), f_wf(e.l2), f_wf(e.h3), f_wf(e.l3), f_wf(e.h4), f_wf(e.l4), f_wf(e.h5), f_wf(e.l5), f_wf(e.barHigh), f_wf(e.barLow), f_wf(e.previousClose), f_wf(e.completion), f_wf(e.broken), f_wf(e.lower), f_wf(e.upper), f_wb(e.up), f_wb(e.allInside), f_wb(e.closeInside), f_wi(e.reason), f_wi(e.made), f_wi(e.ready), f_wi(e.ended))
    array.join(a, ",")
f_unwire(string row) =>
    array<string> a = str.split(row, ",")
    if array.size(a) != 44
        runtime.error("Wire record must contain all 44 event fields")
    CalcEvent.new(symbol=f_wus(array.get(a, 0)), tf=f_wus(array.get(a, 1)), id=f_wus(array.get(a, 2)), sequence=f_wint(a, 3), kind=f_wint(a, 4), serial=f_wint(a, 5), sourceOpen=f_wint(a, 6), sourceClose=f_wint(a, 7), identifiedAt=f_wint(a, 8), previousCloseAt=f_wint(a, 9), o1=f_wint(a, 10), o2=f_wint(a, 11), o3=f_wint(a, 12), o4=f_wint(a, 13), o5=f_wint(a, 14), p1=f_wn(a, 15), p2=f_wn(a, 16), p3=f_wn(a, 17), p4=f_wn(a, 18), p5=f_wn(a, 19), h1=f_wn(a, 20), l1=f_wn(a, 21), h2=f_wn(a, 22), l2=f_wn(a, 23), h3=f_wn(a, 24), l3=f_wn(a, 25), h4=f_wn(a, 26), l4=f_wn(a, 27), h5=f_wn(a, 28), l5=f_wn(a, 29), barHigh=f_wn(a, 30), barLow=f_wn(a, 31), previousClose=f_wn(a, 32), completion=f_wn(a, 33), broken=f_wn(a, 34), lower=f_wn(a, 35), upper=f_wn(a, 36), up=f_wbool(a, 37), allInside=f_wbool(a, 38), closeInside=f_wbool(a, 39), reason=f_wint(a, 40), made=f_wint(a, 41), ready=f_wint(a, 42), ended=f_wint(a, 43))
f_wire_batch(array<CalcEvent> events) =>
    string wire = ""
    if array.size(events) > 0
        for i = 0 to array.size(events) - 1
            CalcEvent e = array.get(events, i)
            string row = f_wire(e)
            CalcEvent decoded = f_unwire(row)
            if f_wire(decoded) != row
                runtime.error("Event codec failed canonical round-trip")
            wire += (i == 0 ? "" : ";") + row
    if str.length(wire) > 32768
        runtime.error("Event wire packet overflow: no truncation allowed")
    wire

f_tjl_wire_snapshot(ContextState c, string symbol, string tf) =>
    if not c.started or c.halted
        "TJL2,UNAVAILABLE,~"
    else if na(c.tjl.current)
        "TJL2,NONE," + f_wi(c.lastClose) + "," + f_wi(c.trendState) + "," + f_wi(c.trendStateSince)
    else
        TJLRecord t = c.tjl.current
        array<string> a = array.from("TJL2", "SET", f_ws(symbol), f_ws(tf), f_wi(t.serial), f_wb(t.up), f_wi(t.highOrigin), f_wi(t.lowOrigin), f_wf(t.highUpper), f_wf(t.highLower), f_wf(t.lowUpper), f_wf(t.lowLower), f_wi(t.made), f_wi(t.ready), f_wi(t.p3), f_wf(t.p3price), f_wi(c.lastClose), f_wi(c.trendState), f_wi(c.trendStateSince))
        array.join(a, ",")

// Independent real detector contexts. Only primitive tuples leave requests.
f_mtf_build(string tf, int reference, bool up) =>
    var ContextState c = f_context(up)
    var array<float> bh = array.new_float()
    var array<float> bl = array.new_float()
    var array<float> highs = array.new_float()
    var array<float> lows = array.new_float()
    var array<int> opens = array.new_int()
    var array<TJLRecord> records = array.new<TJLRecord>()
    var array<CalcEvent> events = array.new<CalcEvent>()
    var int availableFrom = time
    bool ok = c.advanceContext(bh, bl, highs, lows, opens, records, events, syminfo.tickerid, tf, reference, limit, keepTJL, tf == "60" or tf == "5" or tf == "1", tf == "1D" or tf == "240" or tf == "60", open, high, low, close, time, time_close, open[1], high[1], low[1], close[1], time_close[1])
    H1Audit a = f_h1_audit(c, array.size(opens), events)
    string report = a.report + "\nRequested start OPEN: " + f_time(reference) + " | Available source history from: " + f_time(availableFrom)
    string snap = f_tjl_wire_snapshot(c, syminfo.tickerid, tf)
    [time_close, time, bar_index, c.sequence, array.size(events), f_wire_batch(events), report, snap]
f_mtf_prior(string tf, int reference, bool up) =>
    [tc, op, ix, seq, n, wire, report, snap] = f_mtf_build(tf, reference, up)
    [tc[1], op[1], ix[1], seq[1], n[1], wire[1], report[1], snap[1], op, tc, ix]
