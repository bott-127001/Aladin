//@version=6
indicator("TopG v0.4.1 - Explicit Structure Inputs", overlay=true, max_lines_count=450, max_labels_count=450, max_boxes_count=250)
// Sources: MSM.pdf v2, Choch.pdf v2, ISS.pdf v1, MTF-Analysis.pdf v1.
// v0.4.1: shared Structure.step receives its candle and histories explicitly.
// Outer CHOCH/ISS lifecycle and rendering are still chart-context code; no MTF requests yet.
// D-005: draw TJL at pair confirmation; replacement set ready at next point 3.
// No tap activation, usage or trade entries. Compilation/regression verification pending.
start = input.time(timestamp("01 Oct 2026 00:00 +0530"), "Starting candle OPEN time", confirm=true, group="Initialization")
initialDir = input.string("Upward", "Starting direction", options=["Upward", "Downward"], group="Initialization")
msmView = input.string("History", "MSM view", options=["Off", "Latest", "History"], group="Display")
chochView = input.string("History", "CHOCH view", options=["Off", "Latest", "History"], group="Display")
issView = input.string("History", "ISS view", options=["Off", "Latest", "History"], group="Display")
keepPoints = input.int(100, "MSM confirmed points retained", minval=2, maxval=100, group="Display")
keepChoch = input.int(15, "CHOCH events retained", minval=1, maxval=20, group="Display")
keepISS = input.int(15, "ISS events retained", minval=1, maxval=30, group="Display")
showEvents = input.bool(true, "Show discovery / confirmation candle markers", group="Display")
showInternal = input.bool(false, "Show current ISS internal points (diagnostic)", group="Display")
showAudit = input.bool(false, "Show latest CHOCH audit panel", group="Display")
showISSAudit = input.bool(false, "Show ISS audit (takes panel priority)", group="Display")
limit = input.int(20000, "Candle storage safety limit", minval=100, maxval=30000, group="Safety")
bool issScope = timeframe.isminutes and (timeframe.multiplier == 60 or timeframe.multiplier == 5 or timeframe.multiplier == 1)
var array<float> tops = array.new_float()
var array<float> bots = array.new_float()
var array<float> wh = array.new_float()
var array<float> wl = array.new_float()
var array<int> ts = array.new_int()
f_time(int stamp) =>
    na(stamp) ? "None" : str.format_time(stamp, "yyyy-MM-dd HH:mm", syminfo.timezone)
f_price(float price) =>
    str.tostring(price, format.mintick)
f_ext(array<float> a, int first, int last, bool highest) =>
    float best = na
    int chosen = na
    if first >= 0 and last >= first and last < array.size(a)
        for j = first to last
            float v = array.get(a, j)
            if na(best) or (highest ? v >= best : v <= best)
                best := v
                chosen := j
    [best, chosen]
// Shared MSM calculation. This method does not read chart OHLC, time, global
// histories, barstate or drawings. Its caller must supply an eligible closed candle.
// Events: 0=none, 1=tentative, 2=confirmed pair, 3=empty-range skip.
type Structure
    bool up = true
    int ref = 0
    int gate = -1
    bool pending = false
    int ti = na
    int identified = na
    int known = na
    float tentative = na
    float ch = na
    float cl = na
    int hi = na
    int li = na
    int pairs = 0
method step(Structure s, int i, array<float> bodyHighs, array<float> bodyLows, float candleOpen, float candleClose, float previousOpen, float previousClose, float previousHigh, float previousLow, int candleCloseTime) =>
    int eventCode = 0
    if s.pending
        if i > s.identified and (s.up ? candleClose > s.tentative : candleClose < s.tentative)
            [opposite, oi] = f_ext(s.up ? bodyLows : bodyHighs, s.ti, i, not s.up)
            s.ch := s.up ? s.tentative : opposite
            s.cl := s.up ? opposite : s.tentative
            s.hi := s.up ? s.ti : oi
            s.li := s.up ? oi : s.ti
            s.pairs += 1
            s.ref := oi
            s.gate := i
            s.pending := false
            s.tentative := na
            s.ti := na
            eventCode := 2
    else if i >= 1 and i - 1 > s.gate
        bool valid = s.up ? previousClose < previousOpen and candleClose < candleOpen and candleClose < previousLow : previousClose > previousOpen and candleClose > candleOpen and candleClose > previousHigh
        if valid
            if i - 2 < s.ref
                eventCode := 3
            else
                [v, vi] = f_ext(s.up ? bodyHighs : bodyLows, s.ref, i - 2, s.up)
                s.tentative := v
                s.ti := vi
                s.identified := i
                s.known := candleCloseTime
                s.pending := true
                eventCode := 1
    eventCode
var array<line> ml = array.new_line()
var array<label> mb = array.new_label()
var array<label> me = array.new_label()
var array<box> cb = array.new_box()
var array<line> cln = array.new_line()
var array<label> cz = array.new_label()
var array<label> ce = array.new_label()
var array<box> ib = array.new_box()
var array<line> iln = array.new_line()
var array<label> iz = array.new_label()
var array<label> ie = array.new_label()
var array<line> dl = array.new_line()
var array<label> db = array.new_label()
f_clear_points(array<line> ls, array<label> lbs) =>
    while array.size(ls) > 0
        line.delete(array.shift(ls))
        label.delete(array.shift(lbs))
f_trim_points(array<line> ls, array<label> lbs, int cap) =>
    int removed = 0
    while array.size(ls) > cap
        line.delete(array.shift(ls))
        label.delete(array.shift(lbs))
        removed += 1
    removed
f_point(array<line> ls, array<label> lbs, int ix, float price, bool highSide, string caption, color ink, bool dashed) =>
    int origin = array.get(ts, ix)
    line ln = line.new(origin, price, time_close, price, xloc=xloc.bar_time, extend=extend.right, color=ink, style=dashed ? line.style_dashed : line.style_solid)
    label lb = label.new(origin, price, caption, xloc=xloc.bar_time, style=highSide ? label.style_label_down : label.style_label_up, color=ink, textcolor=color.white, size=size.tiny)
    label.set_tooltip(lb, "Origin OPEN: " + f_time(origin) + "\nKnown at close: " + f_time(time_close) + "\nPrice: " + f_price(price))
    array.push(ls, ln)
    array.push(lbs, lb)
f_ztrim(array<box> bs, array<line> ls, array<label> lbs, int cap) =>
    int removed = 0
    while array.size(lbs) > cap
        box.delete(array.shift(bs))
        line.delete(array.shift(ls))
        label.delete(array.shift(lbs))
        removed += 1
    removed
f_zone(array<box> bs, array<line> ls, array<label> lbs, int ix, bool highSide, string caption, color ink) =>
    int origin = array.get(ts, ix)
    float upper = highSide ? array.get(wh, ix) : array.get(bots, ix)
    float lower = highSide ? array.get(tops, ix) : array.get(wl, ix)
    box bx = na
    line ln = na
    if upper > lower
        bx := box.new(left=origin, top=upper, right=time_close, bottom=lower, xloc=xloc.bar_time, extend=extend.right, border_color=ink, bgcolor=color.new(ink, 88))
    else
        ln := line.new(origin, lower, time_close, lower, xloc=xloc.bar_time, extend=extend.right, color=ink, width=2)
    label lb = label.new(origin, highSide ? upper : lower, caption, xloc=xloc.bar_time, style=highSide ? label.style_label_down : label.style_label_up, color=ink, textcolor=color.white, size=size.tiny)
    label.set_tooltip(lb, "Origin OPEN: " + f_time(origin) + "\nConfirmed at close: " + f_time(time_close) + "\nZone: " + f_price(lower) + " to " + f_price(upper) + "\nAnalysis zone, NOT a trade entry")
    array.push(bs, bx)
    array.push(ls, ln)
    array.push(lbs, lb)
f_marker(array<label> a, string caption, string detail, bool bullish, color ink, int cap) =>
    label lb = label.new(time, bullish ? low : high, caption, xloc=xloc.bar_time, style=bullish ? label.style_label_up : label.style_label_down, color=ink, textcolor=color.white, size=size.tiny)
    label.set_tooltip(lb, detail)
    array.push(a, lb)
    int removed = 0
    while array.size(a) > cap
        label.delete(array.shift(a))
        removed += 1
    removed
f_in(float price, float lower, float upper) =>
    price >= lower and price <= upper
var Structure main = Structure.new(up=initialDir == "Upward")
var Structure inside = Structure.new()
var bool started = false
var bool halted = false
var int totalPairs = 0
var int skipped = 0
var int run = 0
var int chochCount = 0
var string trend = "Waiting for start"
var string lastEvent = "None"
var string chochSide = "None"
var int chochClose = na
var string chochAudit = "No confirmed CHOCH."
var int omittedPoints = 0
var int omittedZones = 0
var int omittedEvents = 0
var line tentativeLine = na
var label tentativeLabel = na
// ISS status: eligible search versus tracking-only are deliberately separate.
var bool irunning = false
var bool eligible = false
var float lowerBound = na
var float upperBound = na
var int candidate = 0
var int main3Origin = na
var int main2Origin = na
var int born = na
var string istate = "Waiting for main point 3"
var string issAudit = "No ISS candidate."
var int issCount = 0
var int rejected = 0
var int outsideCompletion = 0
var int cancelled = 0
var int issClose = na
var string issSide = "None"
var array<float> pvalues = array.new_float()
var array<int> porigins = array.new_int()
var line itl = na
var label itb = na
var table panel = table.new(position.top_right, 2, 17, border_width=1, border_color=color.gray)
var table audit = table.new(position.bottom_right, 1, 1, border_width=1, border_color=color.gray)
if barstate.isconfirmed
    if not started and time == start
        started := true
        trend := main.up ? "Marking upward structure" : "Marking downward structure"
    if started and not halted
        if array.size(ts) >= limit
            halted := true
            lastEvent := "STOPPED: candle storage limit"
        else
            array.push(tops, math.max(open, close))
            array.push(bots, math.min(open, close))
            array.push(wh, high)
            array.push(wl, low)
            array.push(ts, time)
            int i = array.size(ts) - 1
            bool continuation = main.pending and i > main.identified and (main.up ? close > main.tentative : close < main.tentative)
            bool reversal = main.pending and not na(main.ch) and not na(main.cl) and (main.up ? close < main.cl : close > main.ch)
            if continuation and reversal and run == 1
                halted := true
                lastEvent := "STOPPED: simultaneous continuation/CHOCH; review needed"
            else
                float oldHigh = main.ch
                float oldLow = main.cl
                int ev = main.step(i, tops, bots, open, close, open[1], close[1], high[1], low[1], time_close)
                bool changed = false
                if ev == 3
                    skipped += 1
                if ev == 1
                    run := 0
                    lastEvent := "Main point 3 identified"
                    if msmView != "Off"
                        f_point(ml, mb, main.ti, main.tentative, main.up, main.up ? "TH pending" : "TL pending", color.orange, true)
                        tentativeLine := array.pop(ml)
                        tentativeLabel := array.pop(mb)
                    if showEvents and msmView != "Off"
                        omittedEvents += f_marker(me, "POINT IDENTIFIED", "Main point 3 identified at " + f_time(time_close), true, color.orange, msmView == "Latest" ? 1 : 40)
                if ev == 2
                    totalPairs += 1
                    if main.pairs >= 2
                        bool agrees = main.up ? main.ch > oldHigh and main.cl > oldLow : main.ch < oldHigh and main.cl < oldLow
                        trend := agrees ? (main.up ? "Upward trend" : "Downward trend") : "Trend not confirmed"
                    line.delete(tentativeLine)
                    label.delete(tentativeLabel)
                    tentativeLine := na
                    tentativeLabel := na
                    run := 0
                    lastEvent := "Pair " + str.tostring(totalPairs) + " confirmed"
                    if msmView == "Latest"
                        f_clear_points(ml, mb)
                    if msmView != "Off"
                        f_point(ml, mb, main.hi, main.ch, true, "CH " + str.tostring(totalPairs), color.red, false)
                        f_point(ml, mb, main.li, main.cl, false, "CL " + str.tostring(totalPairs), color.teal, false)
                        omittedPoints += f_trim_points(ml, mb, keepPoints)
                    if showEvents and msmView != "Off"
                        omittedEvents += f_marker(me, "PAIR CONFIRMED", lastEvent + " at " + f_time(time_close), false, color.blue, msmView == "Latest" ? 1 : 40)
                if ev != 2
                    bool qualifies = main.pending and not na(main.hi) and not na(main.li) and i >= main.identified and (main.up ? close < main.cl : close > main.ch)
                    run := qualifies ? run + 1 : 0
                    if run == 2
                        chochCount += 1
                        chochClose := time_close
                        chochSide := main.up ? "Bearish" : "Bullish"
                        float broken = main.up ? main.cl : main.ch
                        chochAudit := chochSide + " CHOCH #" + str.tostring(chochCount) + " | " + syminfo.tickerid + " | " + timeframe.period + "\nTimes: " + syminfo.timezone
                        chochAudit += "\nBroken level: " + f_price(broken) + "\nClose 1: " + f_time(time_close[1]) + " | " + f_price(close[1]) + "\nClose 2: " + f_time(time_close) + " | " + f_price(close)
                        chochAudit += "\nRequired: both strictly " + (main.up ? "below" : "above") + "; adjacent candles\nPoint 3 origin: " + f_time(array.get(ts, main.ti)) + " | " + f_price(main.tentative)
                        chochAudit += "\nPoint 3 identified: " + f_time(main.known) + "\nEligible by close 1: " + (main.known <= time_close[1] ? "YES" : "NO") + "\nRestart reference OPEN: " + f_time(array.get(ts, main.ti))
                        if chochView != "Off"
                            if chochView == "Latest"
                                int unused = f_ztrim(cb, cln, cz, 0)
                            color ink = main.up ? color.maroon : color.green
                            string tag = " #" + str.tostring(chochCount)
                            f_zone(cb, cln, cz, main.li, false, (main.up ? "SBR" : "QML / A+") + tag, ink)
                            f_zone(cb, cln, cz, main.hi, true, (main.up ? "QML / A+" : "RBS") + tag, ink)
                            f_zone(cb, cln, cz, main.ti, main.up, (main.up ? "Double top" : "Double bottom") + tag, ink)
                            omittedZones += f_ztrim(cb, cln, cz, keepChoch * 3)
                            if showEvents
                                omittedEvents += f_marker(ce, chochSide + " CHOCH" + tag, chochAudit, not main.up, ink, chochView == "Latest" ? 1 : keepChoch)
                        line.delete(tentativeLine)
                        label.delete(tentativeLabel)
                        tentativeLine := na
                        tentativeLabel := na
                        main.ref := main.ti
                        main.gate := i
                        main.up := not main.up
                        main.pairs := 0
                        main.pending := false
                        main.tentative := na
                        main.ti := na
                        run := 0
                        changed := true
                        trend := main.up ? "Marking upward structure" : "Marking downward structure"
                        lastEvent := chochSide + " CHOCH " + str.tostring(chochCount)
                // Main continuation or CHOCH ends unfinished internal search/tracking.
                if ev == 2 or changed
                    if irunning
                        cancelled += 1
                        istate := changed ? "Cancelled by main CHOCH" : "Cancelled by main continuation"
                        issAudit += "\n" + istate + " at " + f_time(time_close)
                    irunning := false
                    eligible := false
                    f_clear_points(dl, db)
                    line.delete(itl)
                    label.delete(itb)
                    itl := na
                    itb := na
                // A new main point 3 starts a fresh fixed-boundary search, never a revival.
                if ev == 1 and not changed and issScope
                    f_clear_points(dl, db)
                    line.delete(itl)
                    label.delete(itb)
                    itl := na
                    itb := na
                    array.clear(pvalues)
                    array.clear(porigins)
                    float level2 = main.up ? main.cl : main.ch
                    if not na(level2)
                        candidate += 1
                        lowerBound := math.min(level2, main.tentative)
                        upperBound := math.max(level2, main.tentative)
                        main3Origin := array.get(ts, main.ti)
                        main2Origin := array.get(ts, main.up ? main.li : main.hi)
                        born := i
                        inside := Structure.new(up=not main.up, ref=main.ti, gate=i)
                        irunning := true
                        eligible := true
                        istate := "Eligible: building internal structure"
                        issAudit := "Candidate #" + str.tostring(candidate) + " | " + syminfo.tickerid + " | " + timeframe.period + "\nTimes: " + syminfo.timezone + "\nStarted at close: " + f_time(time_close)
                        issAudit += "\nFixed inclusive range: " + f_price(lowerBound) + " to " + f_price(upperBound) + "\nMain level 2 origin: " + f_time(main2Origin) + "\nMain level 3 origin: " + f_time(main3Origin)
                    else
                        irunning := false
                        eligible := false
                        istate := "No confirmed main level 2 yet"
                if irunning and i > born
                    int iev = inside.step(i, tops, bots, open, close, open[1], close[1], high[1], low[1], time_close)
                    bool badPoint = iev == 1 ? not f_in(inside.tentative, lowerBound, upperBound) : iev == 2 ? not f_in(inside.ch, lowerBound, upperBound) or not f_in(inside.cl, lowerBound, upperBound) : false
                    if badPoint
                        irunning := false
                        eligible := false
                        rejected += 1
                        istate := "Rejected: internal marked price outside range"
                        issAudit += "\n" + istate + " at " + f_time(time_close)
                        if iev == 1
                            issAudit += "\nRejected tentative price: " + f_price(inside.tentative)
                        else
                            issAudit += "\nRejected pair high/low: " + f_price(inside.ch) + " / " + f_price(inside.cl)
                        f_clear_points(dl, db)
                        line.delete(itl)
                        label.delete(itb)
                        itl := na
                        itb := na
                        array.clear(pvalues)
                        array.clear(porigins)
                    else
                        if iev == 2
                            line.delete(itl)
                            label.delete(itb)
                            itl := na
                            itb := na
                            if eligible
                                array.push(pvalues, inside.up ? inside.ch : inside.cl)
                                array.push(porigins, inside.up ? inside.hi : inside.li)
                                array.push(pvalues, inside.up ? inside.cl : inside.ch)
                                array.push(porigins, inside.up ? inside.li : inside.hi)
                            if showInternal and issView != "Off"
                                f_point(dl, db, inside.hi, inside.ch, true, "iCH " + str.tostring(inside.pairs), color.purple, false)
                                f_point(dl, db, inside.li, inside.cl, false, "iCL " + str.tostring(inside.pairs), color.purple, false)
                                omittedPoints += f_trim_points(dl, db, 20)
                        if iev == 1
                            if showInternal and issView != "Off"
                                f_point(dl, db, inside.ti, inside.tentative, inside.up, "iTentative", color.purple, true)
                                itl := array.pop(dl)
                                itb := array.pop(db)
                            if eligible and inside.pairs == 2 and array.size(pvalues) == 4
                                // All prior tentative/confirmed points have been boundary-checked.
                                bool allInside = f_in(inside.tentative, lowerBound, upperBound)
                                for n = 0 to 3
                                    allInside := allInside and f_in(array.get(pvalues, n), lowerBound, upperBound)
                                bool completionInside = f_in(close, lowerBound, upperBound)
                                issAudit += "\nFifth point identified at close: " + f_time(time_close)
                                for n = 0 to 3
                                    issAudit += "\nInternal P" + str.tostring(n + 1) + ": " + f_price(array.get(pvalues, n)) + " | origin " + f_time(array.get(ts, array.get(porigins, n)))
                                issAudit += "\nInternal P5 tentative: " + f_price(inside.tentative) + " | origin " + f_time(array.get(ts, inside.ti)) + "\nCompletion close: " + f_price(close) + "\nAll five in range: " + (allInside ? "YES" : "NO") + "\nCompletion close in range: " + (completionInside ? "YES" : "NO")
                                if allInside and completionInside
                                    issCount += 1
                                    issClose := time_close
                                    issSide := inside.up ? "Bullish" : "Bearish"
                                    istate := "Confirmed " + issSide + " ISS; search ended"
                                    issAudit += "\nCONFIRMED " + issSide + " ISS #" + str.tostring(issCount) + "\nZones use internal P3 and P4. No additional main CHOCH required."
                                    if issView != "Off"
                                        if issView == "Latest"
                                            int unused = f_ztrim(ib, iln, iz, 0)
                                        string tag = " ISS #" + str.tostring(issCount)
                                        color ink = inside.up ? color.teal : color.fuchsia
                                        f_zone(ib, iln, iz, array.get(porigins, 2), inside.up, (inside.up ? "RBS" : "SBR") + tag, ink)
                                        f_zone(ib, iln, iz, array.get(porigins, 3), not inside.up, (inside.up ? "Buying A+" : "Selling A+") + tag, ink)
                                        omittedZones += f_ztrim(ib, iln, iz, keepISS * 2)
                                        if showEvents
                                            omittedEvents += f_marker(ie, issSide + " ISS #" + str.tostring(issCount), issAudit, inside.up, ink, issView == "Latest" ? 1 : keepISS)
                                    irunning := false
                                    eligible := false
                                else if not completionInside
                                    outsideCompletion += 1
                                    eligible := false
                                    istate := "Tracking ONLY: outside-range completion close"
                                    issAudit += "\nNO ISS. Eligibility permanently lost for this main point 3; internal tracking continues."
                if not issScope
                    istate := "ISS scope: switch to H1 / M5 / M1"
if barstate.islast
    string state = halted ? "HALTED: see last event" : not started ? "Start not found: select loaded candle OPEN" : main.pending ? "Waiting: continuation or CHOCH" : "Searching for pullback"
    array<string> keys = array.from("TopG v0.4.1", "State", "Current direction / chart", "Structure", "Pairs: total / direction", "Confirmed high / low", "Tentative / CHOCH closes", "CHOCH count / side", "Last CHOCH close", "ISS state", "ISS count / last side", "Last ISS close", "ISS rejected / outside close / cancelled", "Candles / empty pairs skipped", "Omitted points / zones / markers", "Last main event", "Scope")
    array<string> vals = array.from("MSM + CHOCH + ISS / UNVERIFIED", state, (main.up ? "Upward" : "Downward") + " / " + timeframe.period, trend, str.tostring(totalPairs) + " / " + str.tostring(main.pairs), f_price(main.ch) + " / " + f_price(main.cl), f_price(main.tentative) + " / " + str.tostring(run), str.tostring(chochCount) + " / " + chochSide, f_time(chochClose), istate, str.tostring(issCount) + " / " + issSide, f_time(issClose), str.tostring(rejected) + " / " + str.tostring(outsideCompletion) + " / " + str.tostring(cancelled), str.tostring(array.size(ts)) + " / " + str.tostring(skipped), str.tostring(omittedPoints) + " / " + str.tostring(omittedZones) + " / " + str.tostring(omittedEvents), lastEvent, "Chart timeframe only; no TJL / entries")
    for row = 0 to 16
        table.cell(panel, 0, row, array.get(keys, row), bgcolor=color.white, text_color=color.black, text_size=size.small)
        table.cell(panel, 1, row, array.get(vals, row), bgcolor=color.white, text_color=color.black, text_size=size.small)
    if showISSAudit or showAudit
        table.cell(audit, 0, 0, showISSAudit ? issAudit : chochAudit, bgcolor=color.white, text_color=color.black, text_halign=text.align_left, text_size=size.small)
    else
        table.clear(audit, 0, 0, 0, 0)

// TJL module is downstream of main detection; view switches never change its state.
tjlView = input.string("History", "TJL view", options=["Off", "Latest", "History"], group="TJL")
keepTJL = input.int(15, "TJL structural pairs retained", minval=2, maxval=20, group="TJL")
showTJLAudit = input.bool(false, "Show TJL audit (takes audit panel priority)", group="TJL")
bool tjlScope = (timeframe.isdaily and timeframe.multiplier == 1) or (timeframe.isminutes and (timeframe.multiplier == 240 or timeframe.multiplier == 60))
type TJLRecord
    int serial = 0
    bool up = true
    int hi = na
    int li = na
    int made = na
    int ready = na
    int p3 = na
    float p3price = na
    int ended = na
    string state = "Structural only - waiting for point 3"
var array<TJLRecord> tjlRecords = array.new<TJLRecord>()
var TJLRecord newestTJL = na
var TJLRecord currentTJL = na
var int seenPairs = 0
var int seenChoch = 0
var int omittedTJL = 0
var int readySets = 0
var array<box> tjb = array.new_box()
var array<line> tjl = array.new_line()
var array<label> tjz = array.new_label()
var table tjPanel = table.new(position.bottom_left, 2, 7, border_width=1, border_color=color.gray)
f_tjl_detail(TJLRecord r) =>
    string detail = "TJL pair #" + str.tostring(r.serial) + " | " + syminfo.tickerid + " | " + timeframe.period + "\nTimes: " + syminfo.timezone + "\nDirection: " + (r.up ? "Bullish" : "Bearish") + "\nStatus: " + r.state
    detail += "\nStructurally marked at close: " + f_time(r.made) + "\nTrade-finding set available at close: " + f_time(r.ready)
    detail += "\nPoint 3 origin: " + f_time(r.p3) + " | " + f_price(r.p3price) + "\nSet ended at close: " + f_time(r.ended)
    detail += "\nTJL1 source OPEN: " + f_time(array.get(ts, r.up ? r.hi : r.li)) + "\nTJL2 source OPEN: " + f_time(array.get(ts, r.up ? r.li : r.hi))
    detail += "\nD-005: drawing is available before replacement set becomes ready.\nNo tap/usage/entry engine yet. Set-ready is timing status, not a trade signal."
    detail
f_tjl_draw(TJLRecord r, bool first) =>
    bool highSide = first ? r.up : not r.up
    int ix = highSide ? r.hi : r.li
    int origin = array.get(ts, ix)
    float upper = highSide ? array.get(wh, ix) : array.get(bots, ix)
    float lower = highSide ? array.get(tops, ix) : array.get(wl, ix)
    bool live = na(r.ended)
    int rightEdge = live ? time_close : r.ended
    color ink = not live ? color.gray : na(r.ready) ? color.orange : r.up ? color.green : color.maroon
    string caption = (first ? "TJL1" : "TJL2 / A+") + " #" + str.tostring(r.serial) + " | " + (not live ? "historical" : na(r.ready) ? "structural only" : "current set")
    box bx = na
    line ln = na
    if upper > lower
        bx := box.new(left=origin, top=upper, right=rightEdge, bottom=lower, xloc=xloc.bar_time, extend=live ? extend.right : extend.none, border_color=ink, bgcolor=color.new(ink, 88))
    else
        ln := line.new(origin, lower, rightEdge, lower, xloc=xloc.bar_time, extend=live ? extend.right : extend.none, color=ink, width=2)
    label lb = label.new(origin, highSide ? upper : lower, caption, xloc=xloc.bar_time, style=highSide ? label.style_label_down : label.style_label_up, color=ink, textcolor=color.white, size=size.tiny)
    string identity = syminfo.tickerid + "|" + timeframe.period + "|" + (r.up ? "BULL|" : "BEAR|") + (highSide ? "H|" : "L|") + str.tostring(origin)
    label.set_tooltip(lb, f_tjl_detail(r) + "\nLevel ID: " + identity + "\nZone: " + f_price(lower) + " to " + f_price(upper))
    array.push(tjb, bx)
    array.push(tjl, ln)
    array.push(tjz, lb)
if barstate.isconfirmed and started and not halted and tjlScope
    if chochCount > seenChoch
        if array.size(tjlRecords) > 0
            for j = 0 to array.size(tjlRecords) - 1
                TJLRecord r = array.get(tjlRecords, j)
                if na(r.ended)
                    r.ended := time_close
                    r.state := "Invalidated by source CHOCH"
        currentTJL := na
        newestTJL := na
    if totalPairs > seenPairs
        newestTJL := TJLRecord.new(serial=totalPairs, up=main.up, hi=main.hi, li=main.li, made=time_close)
        array.push(tjlRecords, newestTJL)
        while array.size(tjlRecords) > keepTJL
            TJLRecord dropped = array.shift(tjlRecords)
            omittedTJL += 1
    int currentIndex = array.size(ts) - 1
    bool newPoint3 = main.pending and main.identified == currentIndex and main.known == time_close
    if newPoint3 and not na(newestTJL)
        if newestTJL.up == main.up and newestTJL.serial == totalPairs and na(newestTJL.ended) and na(newestTJL.ready)
            if not na(currentTJL)
                currentTJL.ended := time_close
                currentTJL.state := "Replaced by next three-point set"
            newestTJL.ready := time_close
            newestTJL.p3 := array.get(ts, main.ti)
            newestTJL.p3price := main.tentative
            newestTJL.state := "Current trade-finding set (timing only)"
            currentTJL := newestTJL
            readySets += 1
    seenPairs := totalPairs
    seenChoch := chochCount
// Monday alone intentionally does nothing. A continuation does not replace currentTJL
// until the next valid point 3 creates a replacement three-point set (D-005).
if barstate.islast
    int deleted = f_ztrim(tjb, tjl, tjz, 0)
    if tjlScope and tjlView != "Off" and array.size(tjlRecords) > 0
        for j = 0 to array.size(tjlRecords) - 1
            TJLRecord r = array.get(tjlRecords, j)
            bool visibleRecord = tjlView == "History" or na(r.ended)
            if visibleRecord
                f_tjl_draw(r, true)
                f_tjl_draw(r, false)
    string tjState = not tjlScope ? "TJL: use D1 / H4 / H1" : halted ? "HALTED: TJL history incomplete" : not started ? "Waiting for selected start" : na(currentTJL) ? "No current three-point set" : "Current set #" + str.tostring(currentTJL.serial)
    string structural = na(newestTJL) ? "None" : "Pair #" + str.tostring(newestTJL.serial) + " / " + newestTJL.state
    table.cell(tjPanel, 0, 0, "TJL - chart timeframe", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 1, 0, tjState, bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 0, 1, "Latest structural pair", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 1, 1, structural, bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 0, 2, "Current set available", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 1, 2, na(currentTJL) ? "None" : f_time(currentTJL.ready), bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 0, 3, "Set readiness / source trend", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 1, 3, str.tostring(readySets) + " sets / " + trend, bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 0, 4, "Historical pairs omitted", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 1, 4, str.tostring(omittedTJL), bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 0, 5, "Orange / colored / gray", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 1, 5, "Structural only / current / archived", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 0, 6, "Execution status", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 1, 6, "No taps / usage / Buy-Sell yet", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(panel, 0, 0, "TopG v0.4.1", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(panel, 1, 0, "MSM CHOCH ISS TJL / UNVERIFIED", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(panel, 1, 16, "Explicit MSM inputs; outer lifecycle chart-only; no entries", bgcolor=color.white, text_color=color.black, text_size=size.small)
    if showTJLAudit
        string report = not na(currentTJL) ? f_tjl_detail(currentTJL) : not na(newestTJL) ? f_tjl_detail(newestTJL) : "No current TJL record. " + tjState
        table.cell(audit, 0, 0, report, bgcolor=color.white, text_color=color.black, text_halign=text.align_left, text_size=size.small)
