//@version=6
indicator("TopG v0.4.5-dev - TJL and Candle State", overlay=true, max_lines_count=450, max_labels_count=450, max_boxes_count=250)
// Sources: MSM.pdf v2, Choch.pdf v2, ISS.pdf v1, MTF-Analysis.pdf v1.
// Explicit-input candle storage, MSM, CHOCH, ISS and TJL lifecycle methods.
// D-006: newest confirmed pair immediately becomes current TJL.
// Chart-only: context orchestration/event transport remain. No taps or entries.
// Compilation and regression verification pending for this revision.
start = input.time(timestamp("01 Oct 2026 00:00 +0530"), "Starting candle OPEN time", confirm=true, group="Initialization")
initialDir = input.string("Upward", "Starting direction", options=["Upward", "Downward"], group="Initialization")
msmView = input.string("History", "MSM view", options=["Off", "Latest", "History"], group="Display")
chochView = input.string("History", "CHOCH view", options=["Off", "Latest", "History"], group="Display")
issView = input.string("History", "ISS view", options=["Off", "Latest", "History"], group="Display")
keepPoints = input.int(100, "MSM confirmed points retained", minval=2, maxval=100, group="Display")
keepChoch = input.int(15, "CHOCH events retained", minval=1, maxval=20, group="Display")
keepISS = input.int(15, "ISS events retained", minval=1, maxval=30, group="Display")
showEvents = input.bool(true, "Show discovery / confirmation candle markers", group="Display")
showInternal = input.bool(false, "Show current ISS internal points (diagnostic)", group="Display")
showAudit = input.bool(false, "Show latest CHOCH audit panel", group="Display")
showISSAudit = input.bool(false, "Show ISS audit (takes panel priority)", group="Display")
limit = input.int(20000, "Candle storage safety limit", minval=100, maxval=30000, group="Safety")
bool issScope = timeframe.isminutes and (timeframe.multiplier == 60 or timeframe.multiplier == 5 or timeframe.multiplier == 1)
// A future context must construct its own store, not share these chart aliases.
type CandleStore
    array<float> bodyHighs = na
    array<float> bodyLows = na
    array<float> wickHighs = na
    array<float> wickLows = na
    array<int> opens = na
method appendCandle(CandleStore s, float candleOpen, float candleHigh, float candleLow, float candleClose, int candleOpenTime) =>
    array.push(s.bodyHighs, math.max(candleOpen, candleClose))
    array.push(s.bodyLows, math.min(candleOpen, candleClose))
    array.push(s.wickHighs, candleHigh)
    array.push(s.wickLows, candleLow)
    array.push(s.opens, candleOpenTime)
    array.size(s.opens) - 1
var CandleStore candles = CandleStore.new(bodyHighs=array.new_float(), bodyLows=array.new_float(), wickHighs=array.new_float(), wickLows=array.new_float(), opens=array.new_int())
var array<float> tops = candles.bodyHighs
var array<float> bots = candles.bodyLows
var array<float> wh = candles.wickHighs
var array<float> wl = candles.wickLows
var array<int> ts = candles.opens
f_time(int stamp) =>
    na(stamp) ? "None" : str.format_time(stamp, "yyyy-MM-dd HH:mm", syminfo.timezone)
f_price(float price) =>
    str.tostring(price, format.mintick)
f_ext(array<float> a, int first, int last, bool highest) =>
    float best = na
    int chosen = na
    if first >= 0 and last >= first and last < array.size(a)
        for j = first to last
            float v = array.get(a, j)
            if na(best) or (highest ? v >= best : v <= best)
                best := v
                chosen := j
    [best, chosen]
f_in(float price, float lower, float upper) =>
    price >= lower and price <= upper
// Calculation methods receive eligible completed source candles from the caller.
type Structure
    bool up = true
    int ref = 0
    int gate = -1
    bool pending = false
    int ti = na
    int identified = na
    int known = na
    float tentative = na
    float ch = na
    float cl = na
    int hi = na
    int li = na
    int pairs = 0
method step(Structure s, int i, array<float> bodyHighs, array<float> bodyLows, float candleOpen, float candleClose, float previousOpen, float previousClose, float previousHigh, float previousLow, int candleCloseTime) =>
    int eventCode = 0
    if s.pending
        if i > s.identified and (s.up ? candleClose > s.tentative : candleClose < s.tentative)
            [opposite, oi] = f_ext(s.up ? bodyLows : bodyHighs, s.ti, i, not s.up)
            s.ch := s.up ? s.tentative : opposite
            s.cl := s.up ? opposite : s.tentative
            s.hi := s.up ? s.ti : oi
            s.li := s.up ? oi : s.ti
            s.pairs += 1
            s.ref := oi
            s.gate := i
            s.pending := false
            s.tentative := na
            s.ti := na
            eventCode := 2
    else if i >= 1 and i - 1 > s.gate
        bool valid = s.up ? previousClose < previousOpen and candleClose < candleOpen and candleClose < previousLow : previousClose > previousOpen and candleClose > candleOpen and candleClose > previousHigh
        if valid
            if i - 2 < s.ref
                eventCode := 3
            else
                [v, vi] = f_ext(s.up ? bodyHighs : bodyLows, s.ref, i - 2, s.up)
                s.tentative := v
                s.ti := vi
                s.identified := i
                s.known := candleCloseTime
                s.pending := true
                eventCode := 1
    eventCode
type ChochState
    int run = 0
    int count = 0
    int confirmedAt = na
    bool bullish = false
method evaluate(ChochState c, Structure s, int i, int structureEvent, float candleClose, int candleCloseTime) =>
    bool confirmed = false
    if structureEvent == 1 or structureEvent == 2
        c.run := 0
    if structureEvent != 2
        bool qualifies = s.pending and not na(s.hi) and not na(s.li) and i >= s.identified and (s.up ? candleClose < s.cl : candleClose > s.ch)
        c.run := qualifies ? c.run + 1 : 0
        if c.run == 2
            c.count += 1
            c.confirmedAt := candleCloseTime
            c.bullish := not s.up
            c.run := 0
            confirmed := true
    confirmed
method restartAfterChoch(Structure s, int confirmationIndex) =>
    s.ref := s.ti
    s.gate := confirmationIndex
    s.up := not s.up
    s.pairs := 0
    s.pending := false
    s.tentative := na
    s.ti := na
    true
// ISS owns its internal engine and histories. None of these methods accesses
// chart OHLC/time, global histories, barstate, drawing objects or view inputs.
// advance codes: 0=none, 1=tentative, 2=pair, 3=rejected, 4=ISS, 5=tracking-only.
type ISSState
    Structure internal = na
    array<float> values = na
    array<int> origins = na
    bool running = false
    bool eligible = false
    float lower = na
    float upper = na
    int born = na
    int candidates = 0
    int count = 0
    int rejected = 0
    int outside = 0
    int cancelled = 0
    int confirmedAt = na
    bool bullish = false
    int internalEvent = 0
    bool fifth = false
    bool allInside = false
    bool closeInside = false
method beginSearch(ISSState s, Structure source, int i) =>
    array.clear(s.values)
    array.clear(s.origins)
    s.internalEvent := 0
    s.fifth := false
    s.allInside := false
    s.closeInside := false
    float level2 = source.up ? source.cl : source.ch
    bool found = not na(level2)
    s.running := found
    s.eligible := found
    if found
        s.candidates += 1
        s.lower := math.min(level2, source.tentative)
        s.upper := math.max(level2, source.tentative)
        s.born := i
        s.internal := Structure.new(up=not source.up, ref=source.ti, gate=i)
    found
method cancelSearch(ISSState s) =>
    bool wasRunning = s.running
    if wasRunning
        s.cancelled += 1
    s.running := false
    s.eligible := false
    wasRunning
method advance(ISSState s, int i, array<float> bodyHighs, array<float> bodyLows, float candleOpen, float candleClose, float previousOpen, float previousClose, float previousHigh, float previousLow, int candleCloseTime) =>
    int result = 0
    s.internalEvent := 0
    s.fifth := false
    s.allInside := false
    s.closeInside := false
    if s.running and i > s.born
        int ev = s.internal.step(i, bodyHighs, bodyLows, candleOpen, candleClose, previousOpen, previousClose, previousHigh, previousLow, candleCloseTime)
        s.internalEvent := ev
        bool bad = ev == 1 ? not f_in(s.internal.tentative, s.lower, s.upper) : ev == 2 ? not f_in(s.internal.ch, s.lower, s.upper) or not f_in(s.internal.cl, s.lower, s.upper) : false
        if bad
            s.running := false
            s.eligible := false
            s.rejected += 1
            array.clear(s.values)
            array.clear(s.origins)
            result := 3
        else
            result := ev == 1 or ev == 2 ? ev : 0
            if ev == 2 and s.eligible
                array.push(s.values, s.internal.up ? s.internal.ch : s.internal.cl)
                array.push(s.origins, s.internal.up ? s.internal.hi : s.internal.li)
                array.push(s.values, s.internal.up ? s.internal.cl : s.internal.ch)
                array.push(s.origins, s.internal.up ? s.internal.li : s.internal.hi)
            if ev == 1 and s.eligible and s.internal.pairs == 2 and array.size(s.values) == 4
                s.fifth := true
                s.allInside := f_in(s.internal.tentative, s.lower, s.upper)
                for n = 0 to 3
                    s.allInside := s.allInside and f_in(array.get(s.values, n), s.lower, s.upper)
                s.closeInside := f_in(candleClose, s.lower, s.upper)
                if s.allInside and s.closeInside
                    s.count += 1
                    s.confirmedAt := candleCloseTime
                    s.bullish := s.internal.up
                    s.running := false
                    s.eligible := false
                    result := 4
                else if not s.closeInside
                    s.outside += 1
                    s.eligible := false
                    result := 5
    result
var array<line> ml = array.new_line()
var array<label> mb = array.new_label()
var array<label> me = array.new_label()
var array<box> cb = array.new_box()
var array<line> cln = array.new_line()
var array<label> cz = array.new_label()
var array<label> ce = array.new_label()
var array<box> ib = array.new_box()
var array<line> iln = array.new_line()
var array<label> iz = array.new_label()
var array<label> ie = array.new_label()
var array<line> dl = array.new_line()
var array<label> db = array.new_label()
f_clear_points(array<line> ls, array<label> lbs) =>
    while array.size(ls) > 0
        line.delete(array.shift(ls))
        label.delete(array.shift(lbs))
f_trim_points(array<line> ls, array<label> lbs, int cap) =>
    int removed = 0
    while array.size(ls) > cap
        line.delete(array.shift(ls))
        label.delete(array.shift(lbs))
        removed += 1
    removed
f_point(array<line> ls, array<label> lbs, int ix, float price, bool highSide, string caption, color ink, bool dashed) =>
    int origin = array.get(ts, ix)
    line ln = line.new(origin, price, time_close, price, xloc=xloc.bar_time, extend=extend.right, color=ink, style=dashed ? line.style_dashed : line.style_solid)
    label lb = label.new(origin, price, caption, xloc=xloc.bar_time, style=highSide ? label.style_label_down : label.style_label_up, color=ink, textcolor=color.white, size=size.tiny)
    label.set_tooltip(lb, "Origin OPEN: " + f_time(origin) + "\nKnown at close: " + f_time(time_close) + "\nPrice: " + f_price(price))
    array.push(ls, ln)
    array.push(lbs, lb)
f_ztrim(array<box> bs, array<line> ls, array<label> lbs, int cap) =>
    int removed = 0
    while array.size(lbs) > cap
        box.delete(array.shift(bs))
        line.delete(array.shift(ls))
        label.delete(array.shift(lbs))
        removed += 1
    removed
f_zone(array<box> bs, array<line> ls, array<label> lbs, int ix, bool highSide, string caption, color ink) =>
    int origin = array.get(ts, ix)
    float upper = highSide ? array.get(wh, ix) : array.get(bots, ix)
    float lower = highSide ? array.get(tops, ix) : array.get(wl, ix)
    box bx = na
    line ln = na
    if upper > lower
        bx := box.new(left=origin, top=upper, right=time_close, bottom=lower, xloc=xloc.bar_time, extend=extend.right, border_color=ink, bgcolor=color.new(ink, 88))
    else
        ln := line.new(origin, lower, time_close, lower, xloc=xloc.bar_time, extend=extend.right, color=ink, width=2)
    label lb = label.new(origin, highSide ? upper : lower, caption, xloc=xloc.bar_time, style=highSide ? label.style_label_down : label.style_label_up, color=ink, textcolor=color.white, size=size.tiny)
    label.set_tooltip(lb, "Origin OPEN: " + f_time(origin) + "\nConfirmed at close: " + f_time(time_close) + "\nZone: " + f_price(lower) + " to " + f_price(upper) + "\nAnalysis zone, NOT a trade entry")
    array.push(bs, bx)
    array.push(ls, ln)
    array.push(lbs, lb)
f_marker(array<label> a, string caption, string detail, bool bullish, color ink, int cap) =>
    label lb = label.new(time, bullish ? low : high, caption, xloc=xloc.bar_time, style=bullish ? label.style_label_up : label.style_label_down, color=ink, textcolor=color.white, size=size.tiny)
    label.set_tooltip(lb, detail)
    array.push(a, lb)
    int removed = 0
    while array.size(a) > cap
        label.delete(array.shift(a))
        removed += 1
    removed
var Structure main = Structure.new(up=initialDir == "Upward")
var ChochState choch = ChochState.new()
var ISSState iss = ISSState.new(internal=Structure.new(), values=array.new_float(), origins=array.new_int())
var bool started = false
var bool halted = false
var int totalPairs = 0
var int skipped = 0
var int run = 0
var int chochCount = 0
var string trend = "Waiting for start"
var string lastEvent = "None"
var string chochSide = "None"
var int chochClose = na
var string chochAudit = "No confirmed CHOCH."
var int omittedPoints = 0
var int omittedZones = 0
var int omittedEvents = 0
var line tentativeLine = na
var label tentativeLabel = na
var int main3Origin = na
var int main2Origin = na
var string istate = "Waiting for main point 3"
var string issAudit = "No ISS candidate."
var line itl = na
var label itb = na
var table panel = table.new(position.top_right, 2, 17, border_width=1, border_color=color.gray)
var table audit = table.new(position.bottom_right, 1, 1, border_width=1, border_color=color.gray)
if barstate.isconfirmed
    if not started and time == start
        started := true
        trend := main.up ? "Marking upward structure" : "Marking downward structure"
    if started and not halted
        if array.size(ts) >= limit
            halted := true
            lastEvent := "STOPPED: candle storage limit"
        else
            int i = candles.appendCandle(open, high, low, close, time)
            bool continuation = main.pending and i > main.identified and (main.up ? close > main.tentative : close < main.tentative)
            bool reversal = main.pending and not na(main.ch) and not na(main.cl) and (main.up ? close < main.cl : close > main.ch)
            if continuation and reversal and run == 1
                halted := true
                lastEvent := "STOPPED: simultaneous continuation/CHOCH; review needed"
            else
                float oldHigh = main.ch
                float oldLow = main.cl
                int ev = main.step(i, tops, bots, open, close, open[1], close[1], high[1], low[1], time_close)
                bool changed = false
                if ev == 3
                    skipped += 1
                if ev == 1
                    run := 0
                    lastEvent := "Main point 3 identified"
                    if msmView != "Off"
                        f_point(ml, mb, main.ti, main.tentative, main.up, main.up ? "TH pending" : "TL pending", color.orange, true)
                        tentativeLine := array.pop(ml)
                        tentativeLabel := array.pop(mb)
                    if showEvents and msmView != "Off"
                        omittedEvents += f_marker(me, "POINT IDENTIFIED", "Main point 3 identified at " + f_time(time_close), true, color.orange, msmView == "Latest" ? 1 : 40)
                if ev == 2
                    totalPairs += 1
                    if main.pairs >= 2
                        bool agrees = main.up ? main.ch > oldHigh and main.cl > oldLow : main.ch < oldHigh and main.cl < oldLow
                        trend := agrees ? (main.up ? "Upward trend" : "Downward trend") : "Trend not confirmed"
                    line.delete(tentativeLine)
                    label.delete(tentativeLabel)
                    tentativeLine := na
                    tentativeLabel := na
                    run := 0
                    lastEvent := "Pair " + str.tostring(totalPairs) + " confirmed"
                    if msmView == "Latest"
                        f_clear_points(ml, mb)
                    if msmView != "Off"
                        f_point(ml, mb, main.hi, main.ch, true, "CH " + str.tostring(totalPairs), color.red, false)
                        f_point(ml, mb, main.li, main.cl, false, "CL " + str.tostring(totalPairs), color.teal, false)
                        omittedPoints += f_trim_points(ml, mb, keepPoints)
                    if showEvents and msmView != "Off"
                        omittedEvents += f_marker(me, "PAIR CONFIRMED", lastEvent + " at " + f_time(time_close), false, color.blue, msmView == "Latest" ? 1 : 40)
                bool confirmedChoch = choch.evaluate(main, i, ev, close, time_close)
                run := choch.run
                if confirmedChoch
                    chochCount := choch.count
                    chochClose := choch.confirmedAt
                    chochSide := choch.bullish ? "Bullish" : "Bearish"
                    float broken = main.up ? main.cl : main.ch
                    chochAudit := chochSide + " CHOCH #" + str.tostring(chochCount) + " | " + syminfo.tickerid + " | " + timeframe.period + "\nTimes: " + syminfo.timezone
                    chochAudit += "\nBroken level: " + f_price(broken) + "\nClose 1: " + f_time(time_close[1]) + " | " + f_price(close[1]) + "\nClose 2: " + f_time(time_close) + " | " + f_price(close)
                    chochAudit += "\nRequired: both strictly " + (main.up ? "below" : "above") + "; adjacent candles\nPoint 3 origin: " + f_time(array.get(ts, main.ti)) + " | " + f_price(main.tentative)
                    chochAudit += "\nPoint 3 identified: " + f_time(main.known) + "\nEligible by close 1: " + (main.known <= time_close[1] ? "YES" : "NO") + "\nRestart reference OPEN: " + f_time(array.get(ts, main.ti))
                    if chochView != "Off"
                        if chochView == "Latest"
                            int unused = f_ztrim(cb, cln, cz, 0)
                        color ink = main.up ? color.maroon : color.green
                        string tag = " #" + str.tostring(chochCount)
                        f_zone(cb, cln, cz, main.li, false, (main.up ? "SBR" : "QML / A+") + tag, ink)
                        f_zone(cb, cln, cz, main.hi, true, (main.up ? "QML / A+" : "RBS") + tag, ink)
                        f_zone(cb, cln, cz, main.ti, main.up, (main.up ? "Double top" : "Double bottom") + tag, ink)
                        omittedZones += f_ztrim(cb, cln, cz, keepChoch * 3)
                        if showEvents
                            omittedEvents += f_marker(ce, chochSide + " CHOCH" + tag, chochAudit, not main.up, ink, chochView == "Latest" ? 1 : keepChoch)
                    line.delete(tentativeLine)
                    label.delete(tentativeLabel)
                    tentativeLine := na
                    tentativeLabel := na
                    bool restarted = main.restartAfterChoch(i)
                    changed := true
                    trend := main.up ? "Marking upward structure" : "Marking downward structure"
                    lastEvent := chochSide + " CHOCH " + str.tostring(chochCount)
                if ev == 2 or changed
                    bool wasRunning = iss.cancelSearch()
                    if wasRunning
                        istate := changed ? "Cancelled by main CHOCH" : "Cancelled by main continuation"
                        issAudit += "\n" + istate + " at " + f_time(time_close)
                    f_clear_points(dl, db)
                    line.delete(itl)
                    label.delete(itb)
                    itl := na
                    itb := na
                if ev == 1 and not changed and issScope
                    f_clear_points(dl, db)
                    line.delete(itl)
                    label.delete(itb)
                    itl := na
                    itb := na
                    bool found = iss.beginSearch(main, i)
                    if found
                        main3Origin := array.get(ts, main.ti)
                        main2Origin := array.get(ts, main.up ? main.li : main.hi)
                        istate := "Eligible: building internal structure"
                        issAudit := "Candidate #" + str.tostring(iss.candidates) + " | " + syminfo.tickerid + " | " + timeframe.period + "\nTimes: " + syminfo.timezone + "\nStarted at close: " + f_time(time_close)
                        issAudit += "\nFixed inclusive range: " + f_price(iss.lower) + " to " + f_price(iss.upper) + "\nMain level 2 origin: " + f_time(main2Origin) + "\nMain level 3 origin: " + f_time(main3Origin)
                    else
                        istate := "No confirmed main level 2 yet"
                if iss.running and i > iss.born
                    int outcome = iss.advance(i, tops, bots, open, close, open[1], close[1], high[1], low[1], time_close)
                    Structure inside = iss.internal
                    int iev = iss.internalEvent
                    if outcome == 3
                        istate := "Rejected: internal marked price outside range"
                        issAudit += "\n" + istate + " at " + f_time(time_close)
                        if iev == 1
                            issAudit += "\nRejected tentative price: " + f_price(inside.tentative)
                        else
                            issAudit += "\nRejected pair high/low: " + f_price(inside.ch) + " / " + f_price(inside.cl)
                        f_clear_points(dl, db)
                        line.delete(itl)
                        label.delete(itb)
                        itl := na
                        itb := na
                    else
                        if iev == 2
                            line.delete(itl)
                            label.delete(itb)
                            itl := na
                            itb := na
                            if showInternal and issView != "Off"
                                f_point(dl, db, inside.hi, inside.ch, true, "iCH " + str.tostring(inside.pairs), color.purple, false)
                                f_point(dl, db, inside.li, inside.cl, false, "iCL " + str.tostring(inside.pairs), color.purple, false)
                                omittedPoints += f_trim_points(dl, db, 20)
                        if iev == 1
                            if showInternal and issView != "Off"
                                f_point(dl, db, inside.ti, inside.tentative, inside.up, "iTentative", color.purple, true)
                                itl := array.pop(dl)
                                itb := array.pop(db)
                            if iss.fifth
                                issAudit += "\nFifth point identified at close: " + f_time(time_close)
                                for n = 0 to 3
                                    issAudit += "\nInternal P" + str.tostring(n + 1) + ": " + f_price(array.get(iss.values, n)) + " | origin " + f_time(array.get(ts, array.get(iss.origins, n)))
                                issAudit += "\nInternal P5 tentative: " + f_price(inside.tentative) + " | origin " + f_time(array.get(ts, inside.ti)) + "\nCompletion close: " + f_price(close) + "\nAll five in range: " + (iss.allInside ? "YES" : "NO") + "\nCompletion close in range: " + (iss.closeInside ? "YES" : "NO")
                                if outcome == 4
                                    string side = iss.bullish ? "Bullish" : "Bearish"
                                    istate := "Confirmed " + side + " ISS; search ended"
                                    issAudit += "\nCONFIRMED " + side + " ISS #" + str.tostring(iss.count) + "\nZones use internal P3 and P4. No additional main CHOCH required."
                                    if issView != "Off"
                                        if issView == "Latest"
                                            int unused = f_ztrim(ib, iln, iz, 0)
                                        string tag = " ISS #" + str.tostring(iss.count)
                                        color ink = inside.up ? color.teal : color.fuchsia
                                        f_zone(ib, iln, iz, array.get(iss.origins, 2), inside.up, (inside.up ? "RBS" : "SBR") + tag, ink)
                                        f_zone(ib, iln, iz, array.get(iss.origins, 3), not inside.up, (inside.up ? "Buying A+" : "Selling A+") + tag, ink)
                                        omittedZones += f_ztrim(ib, iln, iz, keepISS * 2)
                                        if showEvents
                                            omittedEvents += f_marker(ie, side + " ISS #" + str.tostring(iss.count), issAudit, inside.up, ink, issView == "Latest" ? 1 : keepISS)
                                else if outcome == 5
                                    istate := "Tracking ONLY: outside-range completion close"
                                    issAudit += "\nNO ISS. Eligibility permanently lost for this main point 3; internal tracking continues."
                if not issScope
                    istate := "ISS scope: switch to H1 / M5 / M1"
if barstate.islast
    string state = halted ? "HALTED: see last event" : not started ? "Start not found: select loaded candle OPEN" : main.pending ? "Waiting: continuation or CHOCH" : "Searching for pullback"
    string issSide = iss.count == 0 ? "None" : iss.bullish ? "Bullish" : "Bearish"
    array<string> keys = array.from("TopG v0.4.5-dev", "State", "Current direction / chart", "Structure", "Pairs: total / direction", "Confirmed high / low", "Tentative / CHOCH closes", "CHOCH count / side", "Last CHOCH close", "ISS state", "ISS count / last side", "Last ISS close", "ISS rejected / outside close /cancelled", "Candles / empty pairs skipped", "Omitted points / zones / markers", "Last main event", "Scope")
    array<string> vals = array.from("MSM + CHOCH + ISS / UNVERIFIED", state, (main.up ? "Upward" : "Downward") + " / " + timeframe.period, trend, str.tostring(totalPairs) + " / " + str.tostring(main.pairs), f_price(main.ch) + " / " + f_price(main.cl), f_price(main.tentative) + " / " + str.tostring(run), str.tostring(chochCount) + " / " + chochSide, f_time(chochClose), istate, str.tostring(iss.count) + " / " + issSide, f_time(iss.confirmedAt), str.tostring(iss.rejected) + " / " + str.tostring(iss.outside) + " / " + str.tostring(iss.cancelled), str.tostring(array.size(ts)) + " / " + str.tostring(skipped), str.tostring(omittedPoints) + " / " + str.tostring(omittedZones) + " / " + str.tostring(omittedEvents), lastEvent, "Chart timeframe only; no entries")
    for row = 0 to 16
        table.cell(panel, 0, row, array.get(keys, row), bgcolor=color.white, text_color=color.black, text_size=size.small)
        table.cell(panel, 1, row, array.get(vals, row), bgcolor=color.white, text_color=color.black, text_size=size.small)
    if showISSAudit or showAudit
        table.cell(audit, 0, 0, showISSAudit ? issAudit : chochAudit, bgcolor=color.white, text_color=color.black, text_halign=text.align_left, text_size=size.small)
    else
        table.clear(audit, 0, 0, 0, 0)

// TJL inputs and rendering stay outside calculation methods.
tjlView = input.string("History", "TJL view", options=["Off", "Latest", "History"], group="TJL")
keepTJL = input.int(15, "TJL structural pairs retained", minval=2, maxval=20, group="TJL")
showTJLAudit = input.bool(false, "Show TJL audit (takes audit panel priority)", group="TJL")
bool tjlScope = (timeframe.isdaily and timeframe.multiplier == 1) or (timeframe.isminutes and (timeframe.multiplier == 240 or timeframe.multiplier == 60))
type TJLRecord
    int serial = 0
    bool up = true
    int hi = na
    int li = na
    int made = na
    int ready = na
    int p3 = na
    float p3price = na
    int ended = na
    string state = "Current set - newest confirmed pair"
    int highOrigin = na
    int lowOrigin = na
    float highUpper = na
    float highLower = na
    float lowUpper = na
    float lowLower = na
type TJLState
    array<TJLRecord> records = na
    TJLRecord newest = na
    TJLRecord current = na
    int seenPairs = 0
    int seenChoch = 0
    int omitted = 0
    int sets = 0
// Source data is captured at pair confirmation; rendering no longer looks up
// original candle indices. Lifecycle timestamps/status remain intentionally mutable.
method synchronize(TJLState s, Structure source, CandleStore history, int pairCount, int chochEvents, int i, int candleCloseTime, int retainedPairs) =>
    if chochEvents > s.seenChoch
        if array.size(s.records) > 0
            for j = 0 to array.size(s.records) - 1
                TJLRecord r = array.get(s.records, j)
                if na(r.ended)
                    r.ended := candleCloseTime
                    r.state := "Invalidated by source CHOCH"
        s.current := na
        s.newest := na
    if pairCount > s.seenPairs
        if not na(s.current)
            s.current.ended := candleCloseTime
            s.current.state := "Replaced by newer confirmed pair"
        s.newest := TJLRecord.new(serial=pairCount, up=source.up, hi=source.hi, li=source.li, made=candleCloseTime, ready=candleCloseTime, highOrigin=array.get(history.opens, source.hi), lowOrigin=array.get(history.opens, source.li), highUpper=array.get(history.wickHighs, source.hi), highLower=array.get(history.bodyHighs, source.hi), lowUpper=array.get(history.bodyLows, source.li), lowLower=array.get(history.wickLows, source.li))
        s.current := s.newest
        s.sets += 1
        array.push(s.records, s.newest)
        while array.size(s.records) > retainedPairs
            TJLRecord dropped = array.shift(s.records)
            s.omitted += 1
    bool newPoint3 = source.pending and source.identified == i and source.known == candleCloseTime
    if newPoint3 and not na(s.newest)
        if s.newest.up == source.up and s.newest.serial == pairCount and na(s.newest.ended) and na(s.newest.p3)
            s.newest.p3 := array.get(history.opens, source.ti)
            s.newest.p3price := source.tentative
    s.seenPairs := pairCount
    s.seenChoch := chochEvents
    true
var TJLState tjState = TJLState.new(records=array.new<TJLRecord>())
var array<TJLRecord> tjlRecords = tjState.records
// Chart-only presentation aliases; future requested contexts must return snapshots.
var TJLRecord newestTJL = na
var TJLRecord currentTJL = na
var int omittedTJL = 0
var int readySets = 0
var array<box> tjb = array.new_box()
var array<line> tjl = array.new_line()
var array<label> tjz = array.new_label()
var table tjPanel = table.new(position.bottom_left, 2, 7, border_width=1, border_color=color.gray)
f_tjl_detail(TJLRecord r) =>
    string detail = "TJL pair #" + str.tostring(r.serial) + " | " + syminfo.tickerid + " | " + timeframe.period + "\nTimes: " + syminfo.timezone + "\nDirection: " + (r.up ? "Bullish" : "Bearish") + "\nStatus: " + r.state
    detail += "\nStructurally marked at close: " + f_time(r.made) + "\nCurrent set available at close: " + f_time(r.ready)
    detail += "\nSubsequent point 3 origin (optional): " + f_time(r.p3) + " | " + f_price(r.p3price) + "\nSet ended at close: " + f_time(r.ended)
    detail += "\nTJL1 source OPEN: " + f_time(r.up ? r.highOrigin : r.lowOrigin) + "\nTJL2 source OPEN: " + f_time(r.up ? r.lowOrigin : r.highOrigin)
    detail += "\nD-006: newest confirmed pair becomes current immediately; no wait for point 3.\nNo tap/usage/entry engine yet. Current-set status is not a trade signal.\nStart-independent structure selection remains unresolved."
    detail
f_tjl_draw(TJLRecord r, bool first) =>
    bool highSide = first ? r.up : not r.up
    int origin = highSide ? r.highOrigin : r.lowOrigin
    float upper = highSide ? r.highUpper : r.lowUpper
    float lower = highSide ? r.highLower : r.lowLower
    bool live = na(r.ended)
    int rightEdge = live ? time_close : r.ended
    color ink = not live ? color.gray : r.up ? color.green : color.maroon
    string caption = (first ? "TJL1" : "TJL2 / A+") + " #" + str.tostring(r.serial) + " | " + (live ? "current set" : "historical")
    box bx = na
    line ln = na
    if upper > lower
        bx := box.new(left=origin, top=upper, right=rightEdge, bottom=lower, xloc=xloc.bar_time, extend=live ? extend.right : extend.none, border_color=ink, bgcolor=color.new(ink, 88))
    else
        ln := line.new(origin, lower, rightEdge, lower, xloc=xloc.bar_time, extend=live ? extend.right : extend.none, color=ink, width=2)
    label lb = label.new(origin, highSide ? upper : lower, caption, xloc=xloc.bar_time, style=highSide ? label.style_label_down : label.style_label_up, color=ink, textcolor=color.white, size=size.tiny)
    string identity = syminfo.tickerid + "|" + timeframe.period + "|" + (r.up ? "BULL|" : "BEAR|") + (highSide ? "H|" : "L|") + str.tostring(origin)
    label.set_tooltip(lb, f_tjl_detail(r) + "\nLevel ID: " + identity + "\nZone: " + f_price(lower) + " to " + f_price(upper))
    array.push(tjb, bx)
    array.push(tjl, ln)
    array.push(tjz, lb)
if barstate.isconfirmed and started and not halted and tjlScope
    bool synchronized = tjState.synchronize(main, candles, totalPairs, chochCount, array.size(ts) - 1, time_close, keepTJL)
    newestTJL := tjState.newest
    currentTJL := tjState.current
    omittedTJL := tjState.omitted
    readySets := tjState.sets
// Monday alone does nothing. Used-level tracking is not implemented in this release.
if barstate.islast
    int deleted = f_ztrim(tjb, tjl, tjz, 0)
    if tjlScope and tjlView != "Off" and array.size(tjlRecords) > 0
        for j = 0 to array.size(tjlRecords) - 1
            TJLRecord r = array.get(tjlRecords, j)
            bool visibleRecord = tjlView == "History" or na(r.ended)
            if visibleRecord
                f_tjl_draw(r, true)
                f_tjl_draw(r, false)
    string tjStateText = not tjlScope ? "TJL: use D1 / H4 / H1" : halted ? "HALTED: TJL history incomplete" : not started ? "Waiting for selected start" : na(currentTJL) ? "No current confirmed-pair set" : "Current set #" + str.tostring(currentTJL.serial)
    string structural = na(newestTJL) ? "None" : "Pair #" + str.tostring(newestTJL.serial) + " / " + newestTJL.state
    table.cell(tjPanel, 0, 0, "TJL - chart timeframe", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 1, 0, tjStateText, bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 0, 1, "Latest confirmed pair", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 1, 1, structural, bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 0, 2, "Current set available", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 1, 2, na(currentTJL) ? "None" : f_time(currentTJL.ready), bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 0, 3, "Sets created / source trend", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 1, 3, str.tostring(readySets) + " sets / " + trend, bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 0, 4, "Historical pairs omitted", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 1, 4, str.tostring(omittedTJL), bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 0, 5, "Green / maroon / gray", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 1, 5, "Bullish current / bearish current / historical", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 0, 6, "Execution status", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(tjPanel, 1, 6, "No taps / usage / Buy-Sell yet", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(panel, 0, 0, "TopG v0.4.5-dev", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(panel, 1, 0, "MSM CHOCH ISS TJL / UNVERIFIED", bgcolor=color.white, text_color=color.black, text_size=size.small)
    table.cell(panel, 1, 16, "TJL/store refactor; chart-only; no entries", bgcolor=color.white, text_color=color.black, text_size=size.small)
    if showTJLAudit
        string report = not na(currentTJL) ? f_tjl_detail(currentTJL) : not na(newestTJL) ? f_tjl_detail(newestTJL) : "No current TJL record. " + tjStateText
        table.cell(audit, 0, 0, report, bgcolor=color.white, text_color=color.black, text_halign=text.align_left, text_size=size.small)
