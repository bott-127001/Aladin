//@version=6
indicator("TopG MTF Delivery Probe v0.3 - Bounded Scalar Transport", overlay=true, calc_bars_count=1200)
// Synthetic transport harness ONLY. TopG.pine and strategy rules are unchanged.
// v0.2 failed TradingView runtime: Memory limits exceeded.
// No objects/collections cross request.security. Full 44-field fixture rows
// cross as scalar strings; only bounded serialized rows are retained locally.
// Explicit coverage: at most 1200 operating M1 bars, plus requested source cap.
// Pine compile/runtime/replay/reload NOT VERIFIED for this revision.
zone = input.string("America/New_York", "Table timezone (IANA)")
sourceBars = input.int(300, "Requested source bars (coverage limit)", minval=50, maxval=500)
retain = input.int(64, "Serialized full fixture rows retained", minval=8, maxval=256)
dropEvery = input.int(0, "Fault injection: drop every Nth source packet (0 off)", minval=0, maxval=100)
if not (timeframe.isminutes and timeframe.multiplier == 1)
    runtime.error("Transport probe requires an M1 chart")
f_escape(string s) =>
    str.replace_all(str.replace_all(str.replace_all(s, "%", "%25"), ",", "%2C"), ";", "%3B")
f_unescape(string s) =>
    str.replace_all(str.replace_all(str.replace_all(s, "%3B", ";"), "%2C", ","), "%25", "%")
f_i(int v) =>
    na(v) ? "~" : str.tostring(v)
f_f(float v) =>
    na(v) ? "~" : str.tostring(v, "#.################")
f_b(bool v) =>
    v ? "1" : "0"
// Columns exactly match TopG CalcEvent declaration order. Fixture values are
// synthetic sentinels, not market prices, structural points or trade signals.
f_values(string tf, int seq, int slot, int tOpen, int tClose) =>
    bool flag = seq % 2 == 0
    float v = seq + slot * 0.125
    array.from(f_escape(syminfo.tickerid), f_escape(tf), f_escape("FIXTURE|" + tf + "|" + str.tostring(seq)), f_i(seq), f_i(900 + slot), f_i(seq), f_i(tOpen), f_i(tClose), f_i(flag ? tOpen : int(na)), f_i(tOpen), f_i(tOpen - 1), f_i(tOpen - 2), f_i(tOpen - 3), f_i(tOpen - 4), f_i(flag ? int(na) : tOpen - 5), f_f(v + 1), f_f(v + 2), f_f(v + 3), f_f(v + 4), f_f(flag ? float(na) : v + 5), f_f(v + 11), f_f(v - 11), f_f(v + 12), f_f(v - 12), f_f(v + 13), f_f(v - 13), f_f(v + 14), f_f(v - 14), f_f(v + 15), f_f(v - 15), f_f(v + 20), f_f(v - 20), f_f(v - 0.25), f_f(v + 0.25), f_f(v + 0.5), f_f(v - 30), f_f(v + 30), f_b(flag), f_b(not flag), f_b(slot % 2 == 0), f_i(slot), f_i(tOpen), f_i(tClose), f_i(flag ? int(na) : tClose))
f_build(string tf) =>
    var int sequence = 0
    var int firstOpen = time
    int n = bar_index % 3 == 0 ? 0 : bar_index % 3 == 1 ? 2 : 8
    string wire = ""
    if n > 0
        for i = 0 to n - 1
            sequence += 1
            array<string> values = f_values(tf, sequence, i, time, time_close)
            if array.size(values) != 44
                runtime.error("Probe: fixture schema must contain 44 columns")
            wire += (i == 0 ? "" : ";") + array.join(values, ",")
    if str.length(wire) > 32768
        runtime.error("Probe: serialized packet too large; truncation forbidden")
    [sequence, n, wire, firstOpen]
f_confirmed(string tf) =>
    [seq, n, wire, firstOpen] = f_build(tf)
    // Offset every primitive field, never expose developing source payloads.
    [time[1], time_close[1], bar_index[1], seq[1], n[1], wire[1], firstOpen[1]]
f_validate(string row, string tf, int seq, int slot, int tOpen, int tClose) =>
    array<string> actual = str.split(row, ",")
    array<string> expected = f_values(tf, seq, slot, tOpen, tClose)
    if array.size(actual) != 44
        runtime.error("Probe: decoded event must contain 44 columns")
    for i = 0 to 43
        string a = array.get(actual, i)
        string e = array.get(expected, i)
        if i < 3
            if f_unescape(a) != f_unescape(e)
                runtime.error("Probe: string payload mismatch")
        else if i >= 37 and i <= 39
            if (a != "0" and a != "1") or a != e
                runtime.error("Probe: boolean payload mismatch")
        else if a == "~" or e == "~"
            if a != e
                runtime.error("Probe: missing-value payload mismatch")
        else
            float av = str.tonumber(a)
            float ev = str.tonumber(e)
            if na(av) or na(ev) or av != ev
                runtime.error("Probe: numeric payload mismatch")
    true
// Receiver objects are local-only; requested results contain primitives only.
type Receiver
    int observedIndex = na
    int acceptedIndex = na
    int sequence = 0
    int accepted = 0
    int missingEvents = 0
    int missingBars = 0
    int initialUnseen = 0
    int injectedDrops = 0
    int latestClose = na
    int firstOpen = na
    int committedAt = na
    int emptyBatches = 0
    int twoBatches = 0
    int eightBatches = 0
method receive(Receiver r, string tf, int tOpen, int tClose, int idx, int seq, int n, string wire, int firstOpen, array<string> log) =>
    if not na(tClose)
        if na(tOpen) or na(idx) or na(seq) or na(n) or tClose > (tf == "1" ? time_close : time)
            runtime.error("Probe: invalid source metadata or future source close")
        if na(r.observedIndex) or idx != r.observedIndex
            if not na(r.observedIndex) and idx < r.observedIndex
                runtime.error("Probe: source index moved backwards")
            r.observedIndex := idx
            if dropEvery > 0 and idx % dropEvery == 0
                r.injectedDrops += 1
            else
                if n != 0 and n != 2 and n != 8
                    runtime.error("Probe: invalid fixture batch size")
                if na(r.acceptedIndex)
                    if seq < n
                        runtime.error("Probe: initial event sequence regression")
                    r.initialUnseen := seq - n
                else
                    int missing = seq - r.sequence - n
                    if missing < 0
                        runtime.error("Probe: event sequence regression")
                    r.missingEvents += missing
                    r.missingBars += idx - r.acceptedIndex - 1
                if n == 0
                    if wire != ""
                        runtime.error("Probe: empty batch contains payload")
                else
                    array<string> rows = str.split(wire, ";")
                    if array.size(rows) != n
                        runtime.error("Probe: missing or extra event rows")
                    for i = 0 to n - 1
                        string row = array.get(rows, i)
                        bool valid = f_validate(row, tf, seq - n + i + 1, i, tOpen, tClose)
                        array.push(log, row)
                        r.accepted += 1
                        // Bound the log immediately, not after accumulating a bar.
                        if array.size(log) > retain
                            string removed = array.shift(log)
                r.emptyBatches += n == 0 ? 1 : 0
                r.twoBatches += n == 2 ? 1 : 0
                r.eightBatches += n == 8 ? 1 : 0
                r.acceptedIndex := idx
                r.sequence := seq
                r.latestClose := tClose
                r.firstOpen := firstOpen
                r.committedAt := time_close
    true
[do_, dc, di, ds, dn, dw, df] = request.security(syminfo.tickerid, "1D", f_confirmed("1D"), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, calc_bars_count=sourceBars + 2)
[o4, c4, i4, s4, n4, w4, f4] = request.security(syminfo.tickerid, "240", f_confirmed("240"), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, calc_bars_count=sourceBars + 2)
[o1, c1, i1, s1, n1, w1, f1] = request.security(syminfo.tickerid, "60", f_confirmed("60"), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, calc_bars_count=sourceBars + 2)
[o5, c5, i5, s5, n5, w5, f5] = request.security(syminfo.tickerid, "5", f_confirmed("5"), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, calc_bars_count=sourceBars + 2)
var Receiver rd = Receiver.new()
var Receiver r4 = Receiver.new()
var Receiver r1 = Receiver.new()
var Receiver r5 = Receiver.new()
var Receiver rm = Receiver.new()
var array<string> log = array.new_string()
var int firstM1 = na
// Intrabar diagnostics do not commit event state or the record log.
varip array<int> seen = array.new_int(5, na)
varip array<int> observedOpen = array.new_int(5, na)
varip array<int> liveTime = array.new_int(5, na)
varip array<string> modes = array.new_string(5, "Waiting")
array<int> closes = array.from(dc, c4, c1, c5, barstate.isconfirmed ? time_close : int(na))
for i = 0 to 4
    int stamp = array.get(closes, i)
    int old = array.get(seen, i)
    if not na(stamp) and (na(old) or stamp != old)
        array.set(seen, i, stamp)
        array.set(observedOpen, i, time)
        array.set(liveTime, i, barstate.isrealtime ? timenow : na)
        array.set(modes, i, na(old) ? "INITIAL" : barstate.isrealtime ? "LIVE observed" : "Historical mapping")
if barstate.isconfirmed
    if na(firstM1)
        firstM1 := time
    [ms, mn, mw, mf] = f_build("1")
    rd.receive("1D", do_, dc, di, ds, dn, dw, df, log)
    r4.receive("240", o4, c4, i4, s4, n4, w4, f4, log)
    r1.receive("60", o1, c1, i1, s1, n1, w1, f1, log)
    r5.receive("5", o5, c5, i5, s5, n5, w5, f5, log)
    rm.receive("1", time, time_close, bar_index, ms, mn, mw, mf, log)
f_stamp(int t) =>
    na(t) ? "N/A" : str.format_time(t, "yyyy-MM-dd HH:mm:ss", zone)
f_row(table panel, int i, string tf, Receiver r) =>
    array<string> values = array.from(tf, f_stamp(r.firstOpen), f_stamp(r.latestClose), f_stamp(array.get(observedOpen, i)), f_stamp(array.get(liveTime, i)), f_stamp(r.committedAt), str.tostring(r.sequence) + "/" + str.tostring(r.accepted), str.tostring(r.missingEvents) + "/" + str.tostring(r.missingBars), str.tostring(r.initialUnseen), str.tostring(r.emptyBatches) + "/" + str.tostring(r.twoBatches) + "/" + str.tostring(r.eightBatches), array.get(modes, i) + " | drops " + str.tostring(r.injectedDrops))
    for col = 0 to 10
        table.cell(panel, col, i + 2, array.get(values, col), bgcolor=color.white, text_color=color.black, text_size=size.tiny)
var table panel = table.new(position.top_right, 11, 8, border_width=1)
var bool panelReady = false
if not panelReady
    table.merge_cells(panel, 0, 0, 10, 0)
    table.merge_cells(panel, 0, 7, 10, 7)
    panelReady := true
if barstate.islast
    table.cell(panel, 0, 0, "TopG transport probe v0.3 | SYNTHETIC 44-field rows, NOT strategy | " + syminfo.tickerid + " | " + zone, bgcolor=color.white, text_color=color.black, text_size=size.small)
    array<string> headers = array.from("Source", "Source calculation first OPEN", "Accepted source CLOSE", "First observed M1 OPEN", "First observed LIVE", "Committed M1 CLOSE", "Source seq/accepted", "Missing events/bars", "Initial unseen events", "Batches 0/2/8", "Observation / drops")
    for col = 0 to 10
        table.cell(panel, col, 1, array.get(headers, col), bgcolor=color.white, text_color=color.black, text_size=size.tiny)
    f_row(panel, 0, "D1", rd)
    f_row(panel, 1, "H4", r4)
    f_row(panel, 2, "H1", r1)
    f_row(panel, 3, "M5", r5)
    f_row(panel, 4, "M1", rm)
    int accepted = rd.accepted + r4.accepted + r1.accepted + r5.accepted + rm.accepted
    string footer = "LIMITED COVERAGE: max 1200 M1 bars, requested source cap " + str.tostring(sourceBars) + " + 2 offset bars. First committed M1 OPEN " + f_stamp(firstM1) + ". Rows retained/omitted " + str.tostring(array.size(log)) + "/" + str.tostring(accepted - array.size(log))
    footer += ". No entries or global event-time ordering. HTF commits on following M1 bar close. INITIAL is not first availability. v0.2 runtime FAILED memory; v0.3 compile/runtime/replay/reload UNVERIFIED."
    table.cell(panel, 0, 7, footer, bgcolor=color.white, text_color=color.black, text_size=size.tiny)
